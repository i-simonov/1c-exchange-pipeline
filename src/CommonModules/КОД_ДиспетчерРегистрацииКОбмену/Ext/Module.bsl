#Область ПрограммныйИнтерфейс

// Выполняет регистрацию переданных объектов по сценариям, определенным
// в реестрах для используемых планов обмена.
//
// Параметры:
//   ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистрируемых объектов.
//   МассивСсылок - Массив - ссылки одного типа, передаваемые на регистрацию.
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц, Неопределено - менеджер временных таблиц,
//     используемый при выполнении сценариев. Если не указан, создается новый.
//
// ПараметрыРегистрации - см. ПараметрыРегистрацииИзОбъекта.
// Все ссылки задания должны иметь одинаковые параметры операции.
Процедура ЗарегистрироватьПоРееструСценариев(ОбъектМетаданных, МассивСсылок, МенеджерВременныхТаблиц = Неопределено,
	ПараметрыРегистрации = Неопределено) Экспорт

	РеестрСценариев = ПолучитьРеестрСценариевРегистрации(РеестрыСценариевПоПланамОбмена());
	КонтекстРегистрации = НовыйКонтекстРегистрации(РеестрСценариев, МенеджерВременныхТаблиц);
	ДобавитьЗаданиеРегистрации(КонтекстРегистрации, ОбъектМетаданных, МассивСсылок, Неопределено, ПараметрыРегистрации);
	ВыполнитьЗаданияРегистрации(КонтекстРегистрации);

КонецПроцедуры

// Собирает и выполняет конвейер, определенный сценарием регистрации.
//
// Параметры:
//   КонтекстРегистрации - см. НовыйКонтекстРегистрации
//   СценарийРегистрации - Структура, ФиксированнаяСтруктура - описание выполняемого сценария:
//     * Конвейер - ОбъектМетаданных - обработка, реализующая конвейер.
//     * Обработчики - Массив - обработки, образующие последовательность этапов конвейера.
//     * КодыУзлов - Массив - коды узлов, для которых выполняется регистрация.
//   МассивСсылок - Массив - ссылки одного типа, передаваемые на регистрацию.
//   ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистрируемых объектов.
//   ПланОбменаМета - ОбъектМетаданных - объект метаданных плана обмена.
//   РежимВыполнения - Строка, Неопределено - режим выполнения конвейера.
//   ПараметрыРегистрации - см. ПараметрыРегистрацииИзОбъекта.
//
// Возвращаемое значение:
//   Структура:
//     * Конвейер - ОбработкаОбъект - экземпляр выполненного конвейера.
//     * Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//
Функция ВыполнитьСценарийРегистрации(КонтекстРегистрации, СценарийРегистрации, МассивСсылок, ОбъектМетаданных,
	ПланОбменаМета, РежимВыполнения = Неопределено, ПараметрыРегистрации = Неопределено) Экспорт

	КонвейерОбъект = СобратьКонвейер(СценарийРегистрации.Конвейер, СценарийРегистрации.Обработчики);

	Контекст = КонвейерОбъект.НовыйКонтекстВыполнения(СценарийРегистрации, МассивСсылок, ОбъектМетаданных,
		ПланОбменаМета, КонтекстРегистрации.МенеджерВременныхТаблиц, РежимВыполнения);

	Контекст.Данные.Вставить("КонтекстРегистрации", КонтекстРегистрации);
	Контекст.Данные.Вставить("ПараметрыРегистрации", ПараметрыРегистрации);
	КонвейерОбъект.ВыполнитьОбработку(Контекст, Истина);

	Результат = Новый Структура;
	Результат.Вставить("Конвейер", КонвейерОбъект);
	Результат.Вставить("Контекст", Контекст);

	Возврат Результат;

КонецФункции

// Снимает параметры текущей операции записи. Загрузка не определяет политику возврата.
// Источник - объект с ДополнительныеСвойства.
// КОД_Отправитель не требует включения объекта в состав плана обмена.
// Возвращает ФиксированнаяСтруктура:
//  * Отправитель - ПланОбменаСсылка, Неопределено - узел-источник текущего изменения.
//  * ОтправлятьОбратноОтправителю - Булево, Неопределено - явное решение загрузчика
//    либо Неопределено для использования настройки сценария (по умолчанию Ложь).
Функция ПараметрыРегистрацииИзОбъекта(Источник) Экспорт

	Отправитель = Неопределено;
	Источник.ДополнительныеСвойства.Свойство("КОД_Отправитель", Отправитель);

	ВозвратОтправителю = Неопределено;
	Источник.ДополнительныеСвойства.Свойство("КОД_ОтправлятьОбратноОтправителю", ВозвратОтправителю);

	Параметры = Новый Структура;
	Параметры.Вставить("Отправитель", Отправитель);
	Параметры.Вставить("ОтправлятьОбратноОтправителю", ВозвратОтправителю);

	Возврат Новый ФиксированнаяСтруктура(Параметры);

КонецФункции

// Возвращает узел, исключаемый обработчиком после маршрутизации, или Неопределено.
// Явное решение операции имеет приоритет над настройкой сценария.
Функция ИсключаемыйОтправитель(Контекст) Экспорт

	Параметры = Неопределено;
	Контекст.Данные.Свойство("ПараметрыРегистрации", Параметры);

	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Параметры.Отправитель) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОтправлятьОбратно = Параметры.ОтправлятьОбратноОтправителю;

	Если ОтправлятьОбратно = Неопределено Тогда
		Контекст.Выполнение.Сценарий.Свойство("ОтправлятьОбратноОтправителю", ОтправлятьОбратно);
	КонецЕсли;

	Если ОтправлятьОбратно = Неопределено Тогда
		ОтправлятьОбратно = Ложь;
	КонецЕсли;

	Если ТипЗнч(ОтправлятьОбратно) <> Тип("Булево") Тогда
		ВызватьИсключение "ОтправлятьОбратноОтправителю должно быть Булево или Неопределено.";
	КонецЕсли;

	Если ОтправлятьОбратно Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Параметры.Отправитель;

КонецФункции

// Создает экземпляр обработки по переданному объекту метаданных.
//
// Параметры:
//   ОбработкаМета - ОбъектМетаданныхОбработка - объект метаданных обработки.
//
// Возвращаемое значение:
//   ОбработкаОбъект - экземпляр обработки.
//
Функция ПолучитьОбъектОбработки(ОбработкаМета) Экспорт

	ОбработкаОбъект = Обработки[ОбработкаМета.Имя].Создать();

	КОД_ДиспетчерРегистрацииКОбменуПереопределяемый.ПриПолученииОбъектаОбработки(ОбработкаМета, ОбработкаОбъект);

	Возврат ОбработкаОбъект;

КонецФункции

// Возвращает соответствие планов обмена реестрам сценариев регистрации.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - ОбъектМетаданныхПланОбмена - план обмена.
//     * Значение - ОбъектМетаданныхОбработка - обработка, реализующая реестр сценариев регистрации.
//
Функция РеестрыСценариевПоПланамОбмена() Экспорт

	РеестрыПоПланамОбмена = Новый Соответствие;

	КОД_ДиспетчерРегистрацииКОбменуПереопределяемый.РеестрыСценариевПоПланамОбмена(РеестрыПоПланамОбмена);

	Возврат РеестрыПоПланамОбмена;

КонецФункции

// Материализует реестры выбранных планов один раз перед запуском очереди.
//
// Параметры:
//  РеестрыПоПланамОбмена - см. РеестрыСценариевПоПланамОбмена.
//
// Возвращаемое значение:
//  Соответствие - план обмена -> соответствие объектов метаданных массивам сценариев.
Функция ПолучитьРеестрСценариевРегистрации(РеестрыПоПланамОбмена) Экспорт

	РеестрСценариев = Новый Соответствие;

	Для Каждого ЭлементСоответствия Из РеестрыПоПланамОбмена Цикл
		РеестрПлана = ПолучитьОбъектОбработки(ЭлементСоответствия.Значение).РеестрКонвейеровРегистрации();
		РеестрСценариев.Вставить(ЭлементСоответствия.Ключ, РеестрПлана);
	КонецЦикла;

	Возврат РеестрСценариев;

КонецФункции

// Проверяет наличие временной таблицы в менеджере временных таблиц.
//
// Параметры:
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - менеджер, в котором выполняется поиск.
//   ИмяТаблицы - Строка - полное имя временной таблицы.
//
// Возвращаемое значение:
//   Булево - Истина, если временная таблица существует.
//
Функция ВременнаяТаблицаСуществует(МенеджерВременныхТаблиц, ИмяТаблицы) Экспорт

	Для Каждого ВременнаяТаблица Из МенеджерВременныхТаблиц.Таблицы Цикл
		Если ВременнаяТаблица.ПолноеИмя = ИмяТаблицы Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Добавляет задание в очередь регистрации.
//
// Параметры:
//   КонтекстРегистрации - см. НовыйКонтекстРегистрации
//   ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистрируемых объектов.
//   МассивСсылок - Массив - ссылки одного типа, передаваемые на регистрацию.
//   КодыУзлов - Массив, Неопределено - коды узлов, ограничивающие выполнение сценариев.
//     Если не указаны, используются настройки сценария.
//
// ПараметрыРегистрации - см. ПараметрыРегистрацииИзОбъекта.
// Все ссылки задания должны иметь одинаковые параметры операции.
Процедура ДобавитьЗаданиеРегистрации(КонтекстРегистрации, ОбъектМетаданных, МассивСсылок, КодыУзлов = Неопределено,
	ПараметрыРегистрации = Неопределено) Экспорт

	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаданиеРегистрации = Новый Структура;
	ЗаданиеРегистрации.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	ЗаданиеРегистрации.Вставить("МассивСсылок", МассивСсылок);
	ЗаданиеРегистрации.Вставить("КодыУзлов", КодыУзлов);

	// Снимок принадлежит заданию; связанные задания не наследуют его автоматически.
	СнимокПараметров = Неопределено;

	Если ПараметрыРегистрации <> Неопределено Тогда
		СнимокПараметров = Новый ФиксированнаяСтруктура(Новый Структура("Отправитель, ОтправлятьОбратноОтправителю",
				ПараметрыРегистрации.Отправитель, ПараметрыРегистрации.ОтправлятьОбратноОтправителю));
	КонецЕсли;

	ЗаданиеРегистрации.Вставить("ПараметрыРегистрации", СнимокПараметров);

	КонтекстРегистрации.ОчередьРегистрации.Добавить(Новый ФиксированнаяСтруктура(ЗаданиеРегистрации));

КонецПроцедуры

// Создает контекст одной операции регистрации. Реестр подготавливает вызывающий код;
// во время выполнения очереди реестр и вложенные сценарии изменять нельзя.
//
// Параметры:
//  РеестрСценариев - Соответствие, ФиксированноеСоответствие - обязательный готовый реестр:
//   * Ключ - ОбъектМетаданныхПланОбмена - план обмена.
//   * Значение - Соответствие, ФиксированноеСоответствие - объект метаданных -> массив сценариев.
//  МенеджерВременныхТаблиц - МенеджерВременныхТаблиц, Неопределено - менеджер с предыдущей
//    версией объекта. Если не указан, создается новый.
//  РежимВыполнения - Строка, Неопределено - режим для исходных и связанных заданий.
//
// Возвращаемое значение:
//  Структура:
//   * РеестрСценариев - Соответствие, ФиксированноеСоответствие - реестр всей операции.
//   * ОчередьРегистрации - Массив - исходные и связанные задания.
//   * МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - общий менеджер временных таблиц.
//   * РежимВыполнения - Строка, Неопределено - режим выполнения сценариев.
Функция НовыйКонтекстРегистрации(РеестрСценариев, МенеджерВременныхТаблиц = Неопределено,
	РежимВыполнения = Неопределено) Экспорт

	Если ТипЗнч(РеестрСценариев) <> Тип("Соответствие")
		И ТипЗнч(РеестрСценариев) <> Тип("ФиксированноеСоответствие") Тогда
		ВызватьИсключение "Необходимо передать готовый реестр сценариев регистрации.";
	КонецЕсли;

	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;

	КонтекстРегистрации = Новый Структура;
	КонтекстРегистрации.Вставить("РеестрСценариев", РеестрСценариев);
	КонтекстРегистрации.Вставить("ОчередьРегистрации", Новый Массив);
	КонтекстРегистрации.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	КонтекстРегистрации.Вставить("РежимВыполнения", РежимВыполнения);

	Возврат КонтекстРегистрации;

КонецФункции

// Выполняет очередь, включая задания, добавленные обработчиками, по реестру контекста.
// Контекст предназначен для одного запуска; глобальные настройки здесь не читаются.
//
// Параметры:
//  КонтекстРегистрации - см. НовыйКонтекстРегистрации.
//  СобиратьРезультаты - Булево - получать результаты конвейеров до очистки временных таблиц.
//    Для автоматической регистрации сбор отключен, чтобы не выгружать таблицы маршрутов.
//
// Возвращаемое значение:
//  Массив из ТаблицаЗначений - результаты Ссылка/Узел в порядке выполнения сценариев.
//    При отключенном сборе возвращается пустой массив.
Функция ВыполнитьЗаданияРегистрации(КонтекстРегистрации, СобиратьРезультаты = Ложь) Экспорт

	Результаты = Новый Массив;
	ИндексЗадания = 0;

	Пока ИндексЗадания < КонтекстРегистрации.ОчередьРегистрации.Количество() Цикл
		ЗаданиеРегистрации = КонтекстРегистрации.ОчередьРегистрации[ИндексЗадания];
		ВыполнитьЗаданиеРегистрации(КонтекстРегистрации, ЗаданиеРегистрации, Результаты, СобиратьРезультаты);
		ИндексЗадания = ИндексЗадания + 1;
	КонецЦикла;

	Возврат Результаты;

КонецФункции

// Создает менеджер временных таблиц с предыдущим состоянием записываемого объекта.
// Предыдущее состояние помещается во временную таблицу ВТ_ПредыдущаяВерсия.
//
// Параметры:
//   Источник - СправочникОбъект, ДокументОбъект - записываемый объект, состояние которого
//     требуется сохранить до записи.
//
// Возвращаемое значение:
//   МенеджерВременныхТаблиц - менеджер, содержащий временную таблицу ВТ_ПредыдущаяВерсия.
//
Функция СоздатьМенеджерВременныхТаблицПредыдущейВерсииУниверсальный(Источник) Экспорт

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбъектМетаданных = Источник.Метаданные();
	ПоляОбъекта = ПоляОбъектаДляЗапроса(ОбъектМетаданных, "Источник");

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	&ПоляОбъекта
		|ПОМЕСТИТЬ ВТ_ПредыдущаяВерсия
		|ИЗ
		|	&Источник КАК Источник
		|ГДЕ
		|	Источник.Ссылка = &Ссылка";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Источник", ОбъектМетаданных.ПолноеИмя());

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляОбъекта", ПоляОбъекта);
	Запрос.Выполнить();

	Возврат МенеджерВременныхТаблиц;

КонецФункции

// Формирует список полей объекта для использования в тексте запроса.
// В список включаются стандартные и обычные реквизиты без табличных частей.
//
// Параметры:
//   ОбъектМетаданных - ОбъектМетаданныхСправочник, ОбъектМетаданныхДокумент - объект метаданных,
//     поля которого требуется получить.
//   ПсевдонимТаблицы - Строка - псевдоним таблицы объекта в тексте запроса.
//
// Возвращаемое значение:
//   Строка - список полей для секции ВЫБРАТЬ.
//
Функция ПоляОбъектаДляЗапроса(ОбъектМетаданных, ПсевдонимТаблицы) Экспорт

	ПоляОбъекта = Новый Массив;

	Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		ИмяРеквизита = СтандартныйРеквизит.Имя;
		ПоляОбъекта.Добавить(ПсевдонимТаблицы + "." + ИмяРеквизита + " КАК " + ИмяРеквизита);
	КонецЦикла;

	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя;
		ПоляОбъекта.Добавить(ПсевдонимТаблицы + "." + ИмяРеквизита + " КАК " + ИмяРеквизита);
	КонецЦикла;

	Возврат СтрСоединить(ПоляОбъекта, "," + Символы.ПС + "	");

КонецФункции

#КонецОбласти

#Область Диспетчер

Процедура ВыполнитьЗаданиеРегистрации(КонтекстРегистрации, ЗаданиеРегистрации, Результаты, СобиратьРезультаты)

	Для Каждого ЭлементРеестра Из КонтекстРегистрации.РеестрСценариев Цикл
		ПланОбменаМета = ЭлементРеестра.Ключ;
		РеестрПлана = ЭлементРеестра.Значение;
		СценарииРегистрации = РеестрПлана[ЗаданиеРегистрации.ОбъектМетаданных];

		Если СценарииРегистрации = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СценарийРегистрации Из СценарииРегистрации Цикл
			СценарийРегистрации = ПодготовитьСценарийРегистрации(СценарийРегистрации, ЗаданиеРегистрации.КодыУзлов);
			Выполнение = ВыполнитьСценарийРегистрации(КонтекстРегистрации, СценарийРегистрации,
				ЗаданиеРегистрации.МассивСсылок, ЗаданиеРегистрации.ОбъектМетаданных, ПланОбменаМета,
				КонтекстРегистрации.РежимВыполнения, ЗаданиеРегистрации.ПараметрыРегистрации);

			Если СобиратьРезультаты Тогда
				Результаты.Добавить(Выполнение.Конвейер.ПолучитьРезультатРегистрации(Выполнение.Контекст));
			КонецЕсли;

			ОчиститьРабочиеВременныеТаблицы(КонтекстРегистрации.МенеджерВременныхТаблиц);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция СобратьКонвейер(КонвейерМета, Обработчики)

	КонвейерОбъект = ПолучитьОбъектОбработки(КонвейерМета);

	Для Каждого ОбработчикМета Из Обработчики Цикл
		КонвейерОбъект.Добавить(ПолучитьОбъектОбработки(ОбработчикМета));
	КонецЦикла;

	Возврат КонвейерОбъект;

КонецФункции

Функция ПодготовитьСценарийРегистрации(СценарийРегистрации, КодыУзлов)

	Если КодыУзлов = Неопределено Тогда
		Возврат СценарийРегистрации;
	КонецЕсли;

	ПодготовленныйСценарий = Новый Структура(СценарийРегистрации);
	ПодготовленныйСценарий.Вставить("КодыУзлов", КодыУзлов);

	Возврат Новый ФиксированнаяСтруктура(ПодготовленныйСценарий);

КонецФункции

Процедура ОчиститьРабочиеВременныеТаблицы(МенеджерВременныхТаблиц)

	ТекстыУничтожения = Новый Массив;

	Для Каждого ВременнаяТаблица Из МенеджерВременныхТаблиц.Таблицы Цикл

		Если ВременнаяТаблица.ПолноеИмя = "ВТ_ПредыдущаяВерсия" Тогда
			Продолжить;
		КонецЕсли;

		ТекстыУничтожения.Добавить("УНИЧТОЖИТЬ " + ВременнаяТаблица.ПолноеИмя);

	КонецЦикла;

	Если ТекстыУничтожения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;

	Запрос.Текст = СтрСоединить(ТекстыУничтожения, ";" + Символы.ПС);
	Запрос.Выполнить();

КонецПроцедуры
#КонецОбласти
