#Область ПрограммныйИнтерфейс

// Выполняет регистрацию переданных объектов по сценариям, определенным
// в реестрах для используемых планов обмена.
//
// Параметры:
//   ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистрируемых объектов.
//   МассивСсылок - Массив - ссылки одного типа, передаваемые на регистрацию.
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц, Неопределено - менеджер временных таблиц,
//     используемый при выполнении сценариев. Если не указан, создается новый.
//
Процедура ЗарегистрироватьПоРееструСценариев(
	ОбъектМетаданных,
	МассивСсылок,
	МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	КонтекстРегистрации = НовыйКонтекстРегистрации(МенеджерВременныхТаблиц);
	ДобавитьЗаданиеРегистрации(КонтекстРегистрации, ОбъектМетаданных, МассивСсылок);
	ВыполнитьЗаданияРегистрации(КонтекстРегистрации);
	
КонецПроцедуры

// Собирает и выполняет конвейер, определенный сценарием регистрации.
//
// Параметры:
//   КонтекстРегистрации - см. НовыйКонтекстРегистрации
//   СценарийРегистрации - Структура, ФиксированнаяСтруктура - описание выполняемого сценария:
//     * Конвейер - ОбъектМетаданных - обработка, реализующая конвейер.
//     * Обработчики - Массив - обработки, образующие последовательность этапов конвейера.
//     * КодыУзлов - Массив - коды узлов, для которых выполняется регистрация.
//   МассивСсылок - Массив - ссылки одного типа, передаваемые на регистрацию.
//   ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистрируемых объектов.
//   ПланОбменаМета - ОбъектМетаданных - объект метаданных плана обмена.
//   РежимВыполнения - Строка, Неопределено - режим выполнения конвейера.
//
// Возвращаемое значение:
//   Структура:
//     * Конвейер - ОбработкаОбъект - экземпляр выполненного конвейера.
//     * Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//
Функция ВыполнитьСценарийРегистрации(
	КонтекстРегистрации,
	СценарийРегистрации,
	МассивСсылок,
	ОбъектМетаданных,
	ПланОбменаМета,
	РежимВыполнения = Неопределено) Экспорт
	
	КонвейерОбъект = СобратьКонвейер(СценарийРегистрации.Конвейер, СценарийРегистрации.Обработчики);
	
	Контекст = КонвейерОбъект.НовыйКонтекстВыполнения(
		СценарийРегистрации,
		МассивСсылок,
		ОбъектМетаданных,
		ПланОбменаМета,
		КонтекстРегистрации.МенеджерВременныхТаблиц,
		РежимВыполнения);
	
	Контекст.Данные.Вставить("КонтекстРегистрации", КонтекстРегистрации);
	КонвейерОбъект.ВыполнитьОбработку(Контекст, Истина);
	
	ОчиститьРабочиеВременныеТаблицы(КонтекстРегистрации.МенеджерВременныхТаблиц);
	
	Результат = Новый Структура;
	Результат.Вставить("Конвейер", КонвейерОбъект);
	Результат.Вставить("Контекст", Контекст);
	
	Возврат Результат;
	
КонецФункции

// Создает экземпляр обработки по переданному объекту метаданных.
//
// Параметры:
//   ОбработкаМета - ОбъектМетаданныхОбработка - объект метаданных обработки.
//
// Возвращаемое значение:
//   ОбработкаОбъект - экземпляр обработки.
//
Функция ПолучитьОбъектОбработки(ОбработкаМета) Экспорт
	
	ОбработкаОбъект = Обработки[ОбработкаМета.Имя].Создать();
	
	КОД_ДиспетчерРегистрацииКОбменуПереопределяемый.ПриПолученииОбъектаОбработки(
		ОбработкаМета,
		ОбработкаОбъект);
	
	Возврат ОбработкаОбъект;
	
КонецФункции

// Возвращает соответствие планов обмена реестрам сценариев регистрации.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - ОбъектМетаданныхПланОбмена - план обмена.
//     * Значение - ОбъектМетаданныхОбработка - обработка, реализующая реестр сценариев регистрации.
//
Функция РеестрыСценариевПоПланамОбмена() Экспорт
	
	РеестрыПоПланамОбмена = Новый Соответствие;
	
	КОД_ДиспетчерРегистрацииКОбменуПереопределяемый.РеестрыСценариевПоПланамОбмена(РеестрыПоПланамОбмена);
		
	Возврат РеестрыПоПланамОбмена;
	
КонецФункции

// Проверяет наличие временной таблицы в менеджере временных таблиц.
//
// Параметры:
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - менеджер, в котором выполняется поиск.
//   ИмяТаблицы - Строка - полное имя временной таблицы.
//
// Возвращаемое значение:
//   Булево - Истина, если временная таблица существует.
//
Функция ВременнаяТаблицаСуществует(МенеджерВременныхТаблиц, ИмяТаблицы) Экспорт
	
	Для Каждого ВременнаяТаблица Из МенеджерВременныхТаблиц.Таблицы Цикл
		Если ВременнаяТаблица.ПолноеИмя = ИмяТаблицы Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Добавляет задание в очередь регистрации.
//
// Параметры:
//   КонтекстРегистрации - см. НовыйКонтекстРегистрации
//   ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистрируемых объектов.
//   МассивСсылок - Массив - ссылки одного типа, передаваемые на регистрацию.
//   КодыУзлов - Массив, Неопределено - коды узлов, ограничивающие выполнение сценариев.
//     Если не указаны, используются настройки сценария.
//
Процедура ДобавитьЗаданиеРегистрации(
	КонтекстРегистрации,
	ОбъектМетаданных,
	МассивСсылок,
	КодыУзлов = Неопределено) Экспорт
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаданиеРегистрации = Новый Структура;
	ЗаданиеРегистрации.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	ЗаданиеРегистрации.Вставить("МассивСсылок", МассивСсылок);
	ЗаданиеРегистрации.Вставить("КодыУзлов", КодыУзлов);
	
	КонтекстРегистрации.ОчередьРегистрации.Добавить(Новый ФиксированнаяСтруктура(ЗаданиеРегистрации));
	
КонецПроцедуры

// Создает контекст регистрации, объединяющий очередь заданий и общий менеджер
// временных таблиц для выполняемых сценариев.
//
// Параметры:
//   МенеджерВременныхТаблиц - МенеджерВременныхТаблиц, Неопределено - существующий менеджер
//     временных таблиц. Если не указан, создается новый.
//
// Возвращаемое значение:
//   Структура:
//     * ОчередьРегистрации - Массив - задания регистрации.
//     * МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - общий менеджер временных таблиц.
//
Функция НовыйКонтекстРегистрации(МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	КонтекстРегистрации = Новый Структура;
	КонтекстРегистрации.Вставить("ОчередьРегистрации", Новый Массив);
	КонтекстРегистрации.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	
	Возврат КонтекстРегистрации;
	
КонецФункции

// Создает менеджер временных таблиц с предыдущим состоянием записываемого объекта.
// Предыдущее состояние помещается во временную таблицу ВТ_ПредыдущаяВерсия.
//
// Параметры:
//   Источник - СправочникОбъект, ДокументОбъект - записываемый объект, состояние которого
//     требуется сохранить до записи.
//
// Возвращаемое значение:
//   МенеджерВременныхТаблиц - менеджер, содержащий временную таблицу ВТ_ПредыдущаяВерсия.
//
Функция СоздатьМенеджерВременныхТаблицПредыдущейВерсииУниверсальный(Источник) Экспорт
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбъектМетаданных = Источник.Метаданные();
	ПоляОбъекта = ПоляОбъектаДляЗапроса(ОбъектМетаданных, "Источник");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	&ПоляОбъекта
		|ПОМЕСТИТЬ ВТ_ПредыдущаяВерсия
		|ИЗ
		|	&Источник КАК Источник
		|ГДЕ
		|	Источник.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Источник", ОбъектМетаданных.ПолноеИмя());
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляОбъекта", ПоляОбъекта);
	Запрос.Выполнить();
	
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции

// Формирует список полей объекта для использования в тексте запроса.
// В список включаются стандартные и обычные реквизиты без табличных частей.
//
// Параметры:
//   ОбъектМетаданных - ОбъектМетаданныхСправочник, ОбъектМетаданныхДокумент - объект метаданных,
//     поля которого требуется получить.
//   ПсевдонимТаблицы - Строка - псевдоним таблицы объекта в тексте запроса.
//
// Возвращаемое значение:
//   Строка - список полей для секции ВЫБРАТЬ.
//
Функция ПоляОбъектаДляЗапроса(ОбъектМетаданных, ПсевдонимТаблицы) Экспорт
	
	ПоляОбъекта = Новый Массив;
	
	Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		ИмяРеквизита = СтандартныйРеквизит.Имя;
		ПоляОбъекта.Добавить(ПсевдонимТаблицы + "." + ИмяРеквизита + " КАК " + ИмяРеквизита);
	КонецЦикла;
	
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя;
		ПоляОбъекта.Добавить(ПсевдонимТаблицы + "." + ИмяРеквизита + " КАК " + ИмяРеквизита);
	КонецЦикла;
	
	Возврат СтрСоединить(ПоляОбъекта, "," + Символы.ПС + "	");
	
КонецФункции

#КонецОбласти



#Область Диспетчер

Процедура ВыполнитьЗаданияРегистрации(КонтекстРегистрации)
	
	ИндексЗадания = 0;
	
	Пока ИндексЗадания < КонтекстРегистрации.ОчередьРегистрации.Количество() Цикл
		
		ЗаданиеРегистрации = КонтекстРегистрации.ОчередьРегистрации[ИндексЗадания];
		ВыполнитьЗаданиеРегистрации(КонтекстРегистрации, ЗаданиеРегистрации);
		
		ИндексЗадания = ИндексЗадания + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьЗаданиеРегистрации(КонтекстРегистрации, ЗаданиеРегистрации)
	
	РеестрыПоПланамОбмена = РеестрыСценариевПоПланамОбмена();
	
	Для Каждого ЭлементСоответствия Из РеестрыПоПланамОбмена Цикл
		
		ПланОбменаМета = ЭлементСоответствия.Ключ;
		РеестрМета = ЭлементСоответствия.Значение;
		
		РеестрСценариев = ПолучитьОбъектОбработки(РеестрМета).РеестрКонвейеровРегистрации();
		СценарииРегистрации = РеестрСценариев[ЗаданиеРегистрации.ОбъектМетаданных];
		
		Если СценарииРегистрации = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СценарийРегистрации Из СценарииРегистрации Цикл
			
			СценарийРегистрации = ПодготовитьСценарийРегистрации(
				СценарийРегистрации,
				ЗаданиеРегистрации.КодыУзлов);
			
			ВыполнитьСценарийРегистрации(
				КонтекстРегистрации,
				СценарийРегистрации,
				ЗаданиеРегистрации.МассивСсылок,
				ЗаданиеРегистрации.ОбъектМетаданных,
				ПланОбменаМета);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СобратьКонвейер(КонвейерМета, Обработчики)
	
	КонвейерОбъект = ПолучитьОбъектОбработки(КонвейерМета);
	
	Для Каждого ОбработчикМета Из Обработчики Цикл
		КонвейерОбъект.Добавить(ПолучитьОбъектОбработки(ОбработчикМета));
	КонецЦикла;
	
	Возврат КонвейерОбъект;
	
КонецФункции

Функция ПодготовитьСценарийРегистрации(СценарийРегистрации, КодыУзлов)
	
	Если КодыУзлов = Неопределено Тогда
		Возврат СценарийРегистрации;
	КонецЕсли;
	
	ПодготовленныйСценарий = Новый Структура(СценарийРегистрации);
	ПодготовленныйСценарий.Вставить("КодыУзлов", КодыУзлов);
	
	Возврат Новый ФиксированнаяСтруктура(ПодготовленныйСценарий);
	
КонецФункции

Процедура ОчиститьРабочиеВременныеТаблицы(МенеджерВременныхТаблиц)
	
	ТекстыУничтожения = Новый Массив;
	
	Для Каждого ВременнаяТаблица Из МенеджерВременныхТаблиц.Таблицы Цикл
		
		Если ВременнаяТаблица.ПолноеИмя = "ВТ_ПредыдущаяВерсия" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстыУничтожения.Добавить(
			"УНИЧТОЖИТЬ " + ВременнаяТаблица.ПолноеИмя);
		
	КонецЦикла;
	
	Если ТекстыУничтожения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = СтрСоединить(ТекстыУничтожения, ";" + Символы.ПС);
	Запрос.Выполнить();
	
КонецПроцедуры
#КонецОбласти
