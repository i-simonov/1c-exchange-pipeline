Процедура ПрочитатьВходящуюОчередьСообщений(ВызыватьИсключение = Ложь, КлючСообщения = Неопределено) Экспорт

	Порция = Константы.КОД_ПорцияЗагрузкиСообщений.Получить();
	Порция = ?(Порция=0,100,Порция);

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ %1 0 КАК КоличествоПопыток,
		|	КОД_ВходящаяОчередьСообщений.НомерСообщения КАК НомерСообщения,
		|	КОД_ВходящаяОчередьСообщений.Идентификатор КАК Идентификатор,
		|	КОД_ВходящаяОчередьСообщений.Заголовки КАК Заголовки,
		|	КОД_ВходящаяОчередьСообщений.Отправитель КАК Отправитель,
		|	КОД_ВходящаяОчередьСообщений.ТелоСообщения КАК ТелоСообщения,
		|	КОД_ВходящаяОчередьСообщений.ТипСообщения КАК ТипСообщения,
		|	КОД_ВходящаяОчередьСообщений.ДатаВремя КАК ДатаВремя
		|ИЗ
		|	РегистрСведений.КОД_ВходящаяОчередьСообщений КАК КОД_ВходящаяОчередьСообщений
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСообщения,
		|	Идентификатор";

	// При ручной загрузке выбираем только одну запись по обоим измерениям.
	Если КлючСообщения <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПОРЯДОЧИТЬ ПО",
			"ГДЕ НомерСообщения = &НомерСообщения И Идентификатор = &Идентификатор
			|УПОРЯДОЧИТЬ ПО");
		Запрос.УстановитьПараметр("НомерСообщения", КлючСообщения.НомерСообщения);
		Запрос.УстановитьПараметр("Идентификатор", КлючСообщения.Идентификатор);
	КонецЕсли;

	Запрос.Текст = СтрШаблон(Запрос.Текст, Порция);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		// Ручная команда сообщает об удалении; автоматическая загрузка пропускает уже обработанное.
		Если КлючСообщения <> Неопределено И ВызыватьИсключение Тогда
			ВызватьИсключение "Сообщение уже удалено из входящей очереди.";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	РеестрыПоОтправителям = РеестрыСценариевПоОтправителям();

	Пока НЕ РезультатЗапроса.Пустой() Цикл

		Набор = РегистрыСведений.КОД_ВходящаяОчередьСообщений.СоздатьНаборЗаписей();

		Сообщение = РезультатЗапроса.Выбрать();

		Пока Сообщение.Следующий() Цикл

			Попытка

				РеестрМета = РеестрыПоОтправителям[Сообщение.Отправитель];

				Если РеестрМета = Неопределено Тогда
					ВызватьИсключение СтрШаблон("Для отправителя ""%1"" не найден реестр сценариев загрузки.",
						Сообщение.Отправитель);
				КонецЕсли;

				РеестрСценариев = ПолучитьОбъектОбработки(РеестрМета).РеестрКонвейеровРегистрации();
				СценарииЗагрузки = РеестрСценариев[Сообщение.ТипСообщения];

				Если СценарииЗагрузки = Неопределено Тогда
					ВызватьИсключение СтрШаблон(
						"Для отправителя ""%1"" и типа сообщения ""%2"" не найдены сценарии загрузки.",
						Сообщение.Отправитель, Сообщение.ТипСообщения);
				КонецЕсли;

				Для Каждого СценарийЗагрузки Из СценарииЗагрузки Цикл
					ВыполнитьСценарийЗагрузки(Сообщение, СценарийЗагрузки);
				КонецЦикла;

			Исключение
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;

				Если ВызыватьИсключение Тогда ВызватьИсключение; КонецЕсли; //значит за лог отвечает вызывающая сторона

				_ИнформацияОбОшибке = ИнформацияОбОшибке();
				ЗаписатьСообщениеВРегистрОшибок(Сообщение, _ИнформацияОбОшибке)

			КонецПопытки;

			УдалитьВходящееСообщение(Набор, Сообщение)
		КонецЦикла;

		Если КлючСообщения <> Неопределено Тогда
			Возврат;
		КонецЕсли;

		РезультатЗапроса = Запрос.Выполнить();
	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьСценарийЗагрузки(Сообщение, СценарийЗагрузки, РежимВыполнения = "Выполнение") Экспорт

	КонвейерОбъект = СобратьКонвейер(СценарийЗагрузки.Конвейер, СценарийЗагрузки.Обработчики);

	Контекст = КонвейерОбъект.НовыйКонтекстВыполнения(СценарийЗагрузки, Сообщение, РежимВыполнения);

	КонвейерОбъект.ВыполнитьОбработку(Контекст, Истина);

	Результат = Новый Структура;
	Результат.Вставить("Конвейер", КонвейерОбъект);
	Результат.Вставить("Контекст", Контекст);

	Возврат Результат;

КонецФункции

Функция ПолучитьОбъектОбработки(ОбработкаМета) Экспорт

	ОбработкаОбъект = Обработки[ОбработкаМета.Имя].Создать();

	КОД_ДиспетчерЗагрузкиСообщенийПереопределяемый.ПриПолученииОбъектаОбработки(ОбработкаМета, ОбработкаОбъект);

	Возврат ОбработкаОбъект;

КонецФункции

Функция РеестрыСценариевПоОтправителям() Экспорт

	РеестрыПоОтправителям = Новый Соответствие;

	КОД_ДиспетчерЗагрузкиСообщенийПереопределяемый.РеестрыСценариевПоОтправителям(РеестрыПоОтправителям);

	Возврат РеестрыПоОтправителям;

КонецФункции

Процедура ЗаписатьСообщениеВРегистрОшибок(Сообщение, ИнформацияОбОшибке) Экспорт

	НаборОшибка = РегистрыСведений.КОД_ОшибкиЗагрузкиСообщений.СоздатьНаборЗаписей();

	стрОшибка = НаборОшибка.Добавить();

	стрОшибка.НомерСообщения= Сообщение.НомерСообщения;
	стрОшибка.Идентификатор = Сообщение.Идентификатор;
	стрОшибка.Сценарий 		= "ЗагрузкаВходящаяОчередь";
	стрОшибка.УзелОбмена 	= УзелОтправительСообщения(Сообщение, Ложь);
	стрОшибка.Заголовки 	= Сообщение.Заголовки;
	стрОшибка.Отправитель 	= Сообщение.Отправитель;
	стрОшибка.Сообщение 	= новый ХранилищеЗначения(Сообщение.ТелоСообщения, новый СжатиеДанных(9));
	стрОшибка.Ошибка 		= новый ХранилищеЗначения(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке), новый СжатиеДанных(9));
	стрОшибка.content_type = Сообщение.ТипСообщения;

	НаборОшибка.Записать(Ложь);

КонецПроцедуры

Процедура УдалитьВходящееСообщение(Набор, Сообщение) Экспорт

	Набор.Отбор.НомерСообщения.Установить(Сообщение.НомерСообщения);
	Набор.Отбор.Идентификатор.Установить(Сообщение.Идентификатор);
	Набор.Записать();

КонецПроцедуры

Функция СобратьКонвейер(КонвейерМета, Обработчики)

	КонвейерОбъект = ПолучитьОбъектОбработки(КонвейерМета);

	Для Каждого ОбработчикМета Из Обработчики Цикл
		КонвейерОбъект.Добавить(ПолучитьОбъектОбработки(ОбработчикМета));
	КонецЦикла;

	Возврат КонвейерОбъект;

КонецФункции

// Возвращает ссылку на узел-источник для первичной и повторной загрузки.
// Сообщение - Структура, ФиксированнаяСтруктура, ВыборкаИзРезультатаЗапроса.
// Сохраненный узел имеет приоритет над повторным поиском по коду отправителя.
// ТребоватьУзел - Булево: Ложь при журналировании ошибки неизвестного отправителя,
// чтобы сохранить исходное сообщение для повторной загрузки после настройки узла.
Функция УзелОтправительСообщения(Сообщение, ТребоватьУзел = Истина) Экспорт

	ДанныеОтправителя = Новый Структура("Отправитель, УзелОбмена");
	ЗаполнитьЗначенияСвойств(ДанныеОтправителя, Сообщение);
	УзелОтправитель = ДанныеОтправителя.УзелОбмена;

	Если НЕ ЗначениеЗаполнено(УзелОтправитель) Тогда
		КОД_ДиспетчерЗагрузкиСообщенийПереопределяемый.ПриОпределенииУзлаОтправителя(
			ДанныеОтправителя.Отправитель, УзелОтправитель);
	КонецЕсли;

	Если ТребоватьУзел И НЕ ЗначениеЗаполнено(УзелОтправитель) Тогда
		ВызватьИсключение СтрШаблон("Не определен узел обмена для отправителя %1.", ДанныеОтправителя.Отправитель);
	КонецЕсли;

	Возврат УзелОтправитель;

КонецФункции
