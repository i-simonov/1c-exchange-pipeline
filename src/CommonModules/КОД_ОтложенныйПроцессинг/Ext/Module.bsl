// Один исполнитель. Обрабатывает очередь до исчерпания доступных записей.
Процедура ОбработатьРегистр(РазмерПорции = 100, МаксимумПопыток = 5) Экспорт

	Пока ОбработатьПорцию(РазмерПорции, МаксимумПопыток) Цикл
		// Следующая порция включает ошибки, не достигшие предела попыток.
	КонецЦикла;

КонецПроцедуры

// Вызывается в транзакции записи объекта. Новая загрузка запускает обработку заново.
Процедура Зарегистрировать(Ссылка, ВидОбработки) Экспорт

	Если НЕ ТранзакцияАктивна() Тогда
		ВызватьИсключение "Регистрация процессинга должна выполняться в транзакции записи объекта.";
	КонецЕсли;

	Если ВидОбработки = Перечисления.КОД_ВидыОбработкиДокументов.Проведение Тогда
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект <> Неопределено Тогда
			Если КОД_ПодпискиНаСобытияПереопределяемый.ДокументЗакрытДляОтложенногоПроведения(Объект) Тогда
				УдалитьЗаданиеПроведения(Объект);

				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ЗаблокироватьЗадание(Ссылка, ВидОбработки);
	Запись = РегистрыСведений.КОД_ОтложенныйПроцессинг.СоздатьМенеджерЗаписи();
	Запись.Ссылка = Ссылка;
	Запись.ВидОбработки = ВидОбработки;
	Запись.Состояние = Перечисления.КОД_СостоянияОтложеннойОбработки.КОбработке;
	Запись.НомерПопытки = 0;
	Запись.МоментПостановки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись.ТекстОшибки = "";
	Запись.Записать();

КонецПроцедуры

// Ручная обработка одной записи независимо от состояния и лимита попыток.
// Возвращает Ложь, если задание уже обработано или удалено.
// Ошибка откатывает операцию и передается вызывающему коду без изменения задания.
Функция ОбработатьЗадание(Ссылка, ВидОбработки) Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Обработка задания должна вызываться вне транзакции.";
	КонецЕсли;

	НачатьТранзакцию();

	Попытка
		ЗаблокироватьЗадание(Ссылка, ВидОбработки);
		Запись = ПрочитатьЗадание(Ссылка, ВидОбработки);
		ЗаданиеНайдено = Запись.Выбран();

		Если ЗаданиеНайдено Тогда
			ОбработатьСтроку(Запись);

			// Подписки объекта могли снять задание в этой же транзакции.
			Запись = ПрочитатьЗадание(Ссылка, ВидОбработки);

			Если Запись.Выбран() Тогда
				Запись.Удалить();
			КонецЕсли;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		ВызватьИсключение;
	КонецПопытки;

	Возврат ЗаданиеНайдено;

КонецФункции

// Возвращает Истина, если порция была непустой.
Функция ОбработатьПорцию(РазмерПорции = 100, МаксимумПопыток = 5) Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Обработка порции должна вызываться вне транзакции.";
	КонецЕсли;

	Если РазмерПорции <= 0 Или РазмерПорции <> Цел(РазмерПорции) Тогда
		ВызватьИсключение "Размер порции должен быть положительным целым числом.";
	КонецЕсли;

	Если МаксимумПопыток < 1 Или МаксимумПопыток > 99 Или МаксимумПопыток <> Цел(МаксимумПопыток) Тогда
		ВызватьИсключение "Максимум попыток должен быть целым числом от 1 до 99.";
	КонецЕсли;

	РезультатЗапроса = ПрочитатьПорцию(РазмерПорции, МаксимумПопыток);
	Строка = РезультатЗапроса.Выбрать();

	Пока Строка.Следующий() Цикл
		НачатьТранзакцию();

		Попытка
			// Ручной и регламентный запуск не должны одновременно выполнять одно задание.
			ЗаблокироватьЗадание(Строка.Ссылка, Строка.ВидОбработки);
			Запись = ПрочитатьЗадание(Строка.Ссылка, Строка.ВидОбработки);

			Если ЗаданиеДоступно(Запись, МаксимумПопыток) Тогда
				ОбработатьСтроку(Строка);

				// Подписка проведения или записи могла удалить задание в этой транзакции.
				ЗаблокироватьЗадание(Строка.Ссылка, Строка.ВидОбработки);
				Запись = ПрочитатьЗадание(Строка.Ссылка, Строка.ВидОбработки);

				Если Запись.Выбран() Тогда
					Запись.Удалить();
				КонецЕсли;
			КонецЕсли;

			ЗафиксироватьТранзакцию();
		Исключение
			Ошибка = ИнформацияОбОшибке();

			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;

			ЗаписатьОшибку(Строка, ПодробноеПредставлениеОшибки(Ошибка));
		КонецПопытки;
	КонецЦикла;

	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции

Функция ПрочитатьПорцию(РазмерПорции, МаксимумПопыток)

	Запрос = Новый Запрос;

	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		| Процессинг.Ссылка, Процессинг.ВидОбработки, Процессинг.НомерПопытки
		|ИЗ РегистрСведений.КОД_ОтложенныйПроцессинг КАК Процессинг
		|ГДЕ Процессинг.Состояние В (
		| ЗНАЧЕНИЕ(Перечисление.КОД_СостоянияОтложеннойОбработки.КОбработке),
		| ЗНАЧЕНИЕ(Перечисление.КОД_СостоянияОтложеннойОбработки.Ошибка))
		| И Процессинг.НомерПопытки < &МаксимумПопыток
		|УПОРЯДОЧИТЬ ПО Процессинг.МоментПостановки, Процессинг.Ссылка, Процессинг.ВидОбработки",
		Формат(РазмерПорции, "ЧГ=0; ЧДЦ=0"));
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток);

	Возврат Запрос.Выполнить();

КонецФункции

Процедура ОбработатьСтроку(Строка)

	Объект = Строка.Ссылка.ПолучитьОбъект();

	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект отложенного процессинга не найден.";
	КонецЕсли;

	ВидыОбработки = Перечисления.КОД_ВидыОбработкиДокументов;

	Если Строка.ВидОбработки = ВидыОбработки.Запись Тогда
		Объект.Записать();
	ИначеЕсли Строка.ВидОбработки = ВидыОбработки.Проведение Тогда
		Если КОД_ПодпискиНаСобытияПереопределяемый.ДокументЗакрытДляОтложенногоПроведения(Объект) Тогда
			УдалитьЗаданиеПроведения(Объект);

			Возврат;
		КонецЕсли;

		Объект.Записать(РежимЗаписиДокумента.Проведение);
	ИначеЕсли Строка.ВидОбработки = ВидыОбработки.Распроведение Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Строка.ВидОбработки = ВидыОбработки.ПометкаНаУдаление Тогда
		Объект.УстановитьПометкуУдаления(Истина);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный вид обработки: %1.", Строка.ВидОбработки);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьОшибку(Строка, ТекстОшибки)

	НачатьТранзакцию();

	Попытка
		ЗаблокироватьЗадание(Строка.Ссылка, Строка.ВидОбработки);
		Запись = ПрочитатьЗадание(Строка.Ссылка, Строка.ВидОбработки);

		// Не восстанавливаем задание, снятое проведением или удалением документа.
		Если Запись.Выбран() Тогда
			Запись.Состояние = Перечисления.КОД_СостоянияОтложеннойОбработки.Ошибка;
			Запись.НомерПопытки = Мин(Запись.НомерПопытки + 1, 99);
			Запись.ТекстОшибки = ТекстОшибки;
			Запись.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Снимает задания объекта независимо от состояния и количества попыток.
// Без вида обработки снимает все задания; с видом — только указанную операцию.
// Вызывается внутри транзакции записи или удаления объекта и откатывается вместе с ней.
Процедура УдалитьЗаданияОбъекта(Источник, ВидОбработки = Неопределено) Экспорт

	Если НЕ ТипПоддерживается(Источник) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ТранзакцияАктивна() Тогда
		ВызватьИсключение "Снятие заданий должно выполняться в транзакции объекта.";
	КонецЕсли;

	ПрежнийПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);

	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КОД_ОтложенныйПроцессинг");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Источник.Ссылка);
		Набор = РегистрыСведений.КОД_ОтложенныйПроцессинг.СоздатьНаборЗаписей();
		Набор.Отбор.Ссылка.Установить(Источник.Ссылка);

		Если ВидОбработки <> Неопределено Тогда
			ЭлементБлокировки.УстановитьЗначение("ВидОбработки", ВидОбработки);
			Набор.Отбор.ВидОбработки.Установить(ВидОбработки);
		КонецЕсли;

		Блокировка.Заблокировать();
		// Пустой набор удаляет только записи, попадающие в установленный отбор.
		Набор.Записать(Истина);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПривилегированныйРежим(ПрежнийПривилегированныйРежим);

КонецПроцедуры

// Совместимость с прежним программным интерфейсом.
Процедура УдалитьВсеЗаданияДокумента(Источник) Экспорт

	УдалитьЗаданияОбъекта(Источник);

КонецПроцедуры

Процедура УдалитьЗаданиеПроведения(Источник) Экспорт

	УдалитьЗаданияОбъекта(Источник, Перечисления.КОД_ВидыОбработкиДокументов.Проведение);

КонецПроцедуры

Функция ТипПоддерживается(Источник) Экспорт

	Возврат Метаданные.РегистрыСведений.КОД_ОтложенныйПроцессинг
		.Измерения.Ссылка.Тип.СодержитТип(ТипЗнч(Источник.Ссылка));

КонецФункции

Функция ПрочитатьЗадание(Ссылка, ВидОбработки)

	Запись = РегистрыСведений.КОД_ОтложенныйПроцессинг.СоздатьМенеджерЗаписи();
	Запись.Ссылка = Ссылка;
	Запись.ВидОбработки = ВидОбработки;
	Запись.Прочитать();

	Возврат Запись;

КонецФункции

Функция ЗаданиеДоступно(Запись, МаксимумПопыток)

	Если НЕ Запись.Выбран() Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояния = Перечисления.КОД_СостоянияОтложеннойОбработки;

	Возврат (Запись.Состояние = Состояния.КОбработке Или Запись.Состояние = Состояния.Ошибка)
		И Запись.НомерПопытки < МаксимумПопыток;

КонецФункции

Процедура ЗаблокироватьЗадание(Ссылка, ВидОбработки)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КОД_ОтложенныйПроцессинг");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки.УстановитьЗначение("ВидОбработки", ВидОбработки);
	Блокировка.Заблокировать();

КонецПроцедуры
