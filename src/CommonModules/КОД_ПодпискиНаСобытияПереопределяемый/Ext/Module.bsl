#Область Подписки_на_события

// Сохраняет состояние до записи для использования сценариями регистрации,
// которым требуется предыдущее состояние объекта.
//
// Параметры:
//   Источник - ДокументОбъект - записываемый документ.
//   Отказ - Булево - признак отказа от записи.
//   РежимЗаписи - РежимЗаписиДокумента - режим записи документа.
//   РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ОбменПередЗаписьюДокументы(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов")
		И Источник.ДополнительныеСвойства.ОтключитьМеханизмРегистрацииОбъектов Тогда 
		
		Возврат; 
	КонецЕсли;

	МенеджерВременныхТаблиц = КОД_ДиспетчерРегистрацииКОбмену
								.СоздатьМенеджерВременныхТаблицПредыдущейВерсииУниверсальный(Источник);
	
	КонтекстПередЗаписью = Новый Структура;
	КонтекстПередЗаписью.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	
	Источник.ДополнительныеСвойства.Вставить("ПередЗаписью", КонтекстПередЗаписью);

КонецПроцедуры

Процедура ОбменПриЗаписиДокументы(Источник, Отказ) Экспорт

	Если Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов")
		И Источник.ДополнительныеСвойства.ОтключитьМеханизмРегистрацииОбъектов Тогда 
		
		Возврат; 
	КонецЕсли;

	МетаданныеОбъекта = Источник.Метаданные();
			
	МассивСсылок = ОбернутьВМассив(Источник.Ссылка);
	
	МенеджерВременныхТаблиц = Неопределено;
	ЕстьМВТ = Источник.ДополнительныеСвойства.Свойство("ПередЗаписью") 
		И Источник.ДополнительныеСвойства.ПередЗаписью.Свойство("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	
	КОД_ДиспетчерРегистрацииКОбмену.ЗарегистрироватьПоРееструСценариев(
		МетаданныеОбъекта,
		МассивСсылок,
		МенеджерВременныхТаблиц,
		КОД_ДиспетчерРегистрацииКОбмену.ПараметрыРегистрацииИзОбъекта(Источник));
		
КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция ОбернутьВМассив(Значение)
	
	Массив = новый Массив;
	Массив.Добавить(Значение);
	
	Возврат Массив;
	
КонецФункции

#КонецОбласти

#Область ОтложеннаяОбработка

Процедура ОтложенноеПроведениеОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	КОД_ОтложенныйПроцессинг.УдалитьЗаданиеПроведения(Источник);

КонецПроцедуры

Процедура ОтложеннаяОбработкаОбработкаУдаленияПроведения(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	КОД_ОтложенныйПроцессинг.УдалитьЗаданияОбъекта(Источник,
		Перечисления.КОД_ВидыОбработкиДокументов.Распроведение);

КонецПроцедуры

Процедура ОтложенноеПроведениеПередУдалением(Источник, Отказ) Экспорт

	ОтложеннаяОбработкаПередУдалением(Источник, Отказ);

КонецПроцедуры

// Общий обработчик физического удаления документов и элементов справочников.
Процедура ОтложеннаяОбработкаПередУдалением(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	КОД_ОтложенныйПроцессинг.УдалитьЗаданияОбъекта(Источник);

КонецПроцедуры

Процедура ОтложенноеПроведениеПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если НЕ КОД_ОтложенныйПроцессинг.ТипПоддерживается(Источник) Тогда
		Возврат;
	КонецЕсли;

	ОтложеннаяОбработкаПриЗаписи(Источник, Отказ);

	Если ДокументЗакрытДляОтложенногоПроведения(Источник) Тогда
		КОД_ОтложенныйПроцессинг.УдалитьЗаданиеПроведения(Источник);
	КонецЕсли;

КонецПроцедуры

// Запись объекта выполняет задания записи; установленная пометка — задания пометки.
Процедура ОтложеннаяОбработкаПриЗаписи(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если НЕ КОД_ОтложенныйПроцессинг.ТипПоддерживается(Источник) Тогда
		Возврат;
	КонецЕсли;

	ВидыОбработки = Перечисления.КОД_ВидыОбработкиДокументов;
	КОД_ОтложенныйПроцессинг.УдалитьЗаданияОбъекта(Источник, ВидыОбработки.Запись);

	Если Источник.ПометкаУдаления Тогда
		КОД_ОтложенныйПроцессинг.УдалитьЗаданияОбъекта(Источник, ВидыОбработки.ПометкаНаУдаление);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Прикладное условие снятия задания при записи и запрета повторной постановки.
// При внедрении добавьте проверку статуса прикладного документа, например:
// ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента")
// и Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт.
Функция ДокументЗакрытДляОтложенногоПроведения(Источник) Экспорт

	Возврат Ложь;

КонецФункции
