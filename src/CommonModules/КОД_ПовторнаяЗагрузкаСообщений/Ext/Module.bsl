#Область ПрограммныйИнтерфейс

// Один исполнитель. Повторяет загрузку до исчерпания доступных записей.
// Записи на контроле и записи с исчерпанным лимитом остаются в регистре.
// МаксимумПопыток ограничивает общее значение счетчика КоличествоПопыток.
Процедура ОбработатьРегистр(РазмерПорции = 100, МаксимумПопыток = 5) Экспорт

	Пока ОбработатьПорцию(РазмерПорции, МаксимумПопыток) Цикл
		// Следующая порция включает ошибки, не достигшие предела попыток.
	КонецЦикла;

КонецПроцедуры

// Вызывается вне транзакции. Возвращает Истина, если порция была непустой.
// Все сценарии одного сообщения и удаление ошибки выполняются в одной транзакции.
Функция ОбработатьПорцию(РазмерПорции = 100, МаксимумПопыток = 5) Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Повторная загрузка должна вызываться вне транзакции.";
	КонецЕсли;

	Если РазмерПорции <= 0 Или РазмерПорции <> Цел(РазмерПорции) Тогда
		ВызватьИсключение "Размер порции должен быть положительным целым числом.";
	КонецЕсли;

	Если МаксимумПопыток < 1 Или МаксимумПопыток > 9999999999
		Или МаксимумПопыток <> Цел(МаксимумПопыток) Тогда
		ВызватьИсключение "Максимум попыток должен быть целым числом от 1 до 9999999999.";
	КонецЕсли;

	РезультатЗапроса = ПрочитатьПорцию(РазмерПорции, МаксимумПопыток);

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;

	РеестрыПоОтправителям = КОД_ДиспетчерЗагрузкиСообщений.РеестрыСценариевПоОтправителям();
	Строка = РезультатЗапроса.Выбрать();

	Пока Строка.Следующий() Цикл
		ОбработатьЗапись(Строка, Ложь, МаксимумПопыток, РеестрыПоОтправителям);
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Одна попытка для конкретной записи. При ручном вызове лимит и контроль
// не препятствуют загрузке. Тело читается из регистра, после явного сохранения в форме.
// Результат: Успешно - Булево, Пропущено - Булево, ТекстОшибки - Строка.
Функция ОбработатьЗапись(КлючЗаписи, Принудительно = Истина,
	МаксимумПопыток = 5, РеестрыПоОтправителям = Неопределено) Экспорт

	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Повторная загрузка должна вызываться вне транзакции.";
	КонецЕсли;

	Результат = Новый Структура("Успешно, Пропущено, ТекстОшибки", Ложь, Ложь, "");
	Менеджер = РегистрыСведений.КОД_ОшибкиЗагрузкиСообщений;
	НачатьТранзакцию();

	Попытка
		Менеджер.ЗаблокироватьЗапись(КлючЗаписи);
		Запись = Менеджер.ПрочитатьЗапись(КлючЗаписи);

		Если Запись = Неопределено Тогда
			Результат.Пропущено = Истина;
		ИначеЕсли НЕ Принудительно
			И (Запись.НаКонтроле Или Запись.КоличествоПопыток >= МаксимумПопыток) Тогда
			Результат.Пропущено = Истина;
		Иначе
			Если РеестрыПоОтправителям = Неопределено Тогда
				РеестрыПоОтправителям = КОД_ДиспетчерЗагрузкиСообщений.РеестрыСценариевПоОтправителям();
			КонецЕсли;

			ОбработатьСообщение(Запись, РеестрыПоОтправителям);
			Запись.Удалить();
			Результат.Успешно = Истина;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		Ошибка = ИнформацияОбОшибке();

		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;

		Результат.Успешно = Ложь;
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ЗаписатьОшибку(КлючЗаписи, Результат.ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьПорцию(РазмерПорции, МаксимумПопыток)

	Запрос = Новый Запрос;

	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		| Ошибки.НомерСообщения, Ошибки.Идентификатор,
		| Ошибки.Сценарий, Ошибки.content_type, Ошибки.УзелОбмена
		|ИЗ РегистрСведений.КОД_ОшибкиЗагрузкиСообщений КАК Ошибки
		|ГДЕ НЕ Ошибки.НаКонтроле
		| И Ошибки.КоличествоПопыток < &МаксимумПопыток
		|УПОРЯДОЧИТЬ ПО Ошибки.КоличествоПопыток, Ошибки.НомерСообщения,
		| Ошибки.Идентификатор, Ошибки.Сценарий, Ошибки.content_type, Ошибки.УзелОбмена",
		Формат(РазмерПорции, "ЧГ=0; ЧДЦ=0"));
	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток);

	Возврат Запрос.Выполнить();

КонецФункции

Процедура ОбработатьСообщение(Запись, РеестрыПоОтправителям)

	РеестрМета = РеестрыПоОтправителям[Запись.Отправитель];

	Если РеестрМета = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Для отправителя ""%1"" не найден реестр сценариев загрузки.", Запись.Отправитель);
	КонецЕсли;

	РеестрОбъект = КОД_ДиспетчерЗагрузкиСообщений.ПолучитьОбъектОбработки(РеестрМета);
	РеестрСценариев = РеестрОбъект.РеестрКонвейеровРегистрации();
	СценарииЗагрузки = РеестрСценариев[Запись.content_type];

	Если СценарииЗагрузки = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Для отправителя ""%1"" и типа сообщения ""%2"" не найдены сценарии загрузки.",
			Запись.Отправитель, Запись.content_type);
	КонецЕсли;

	Если СценарииЗагрузки.Количество() = 0 Тогда
		ВызватьИсключение "Список сценариев загрузки сообщения пуст.";
	КонецЕсли;

	Сообщение = Новый Структура;
	Сообщение.Вставить("НомерСообщения", Запись.НомерСообщения);
	Сообщение.Вставить("Идентификатор", Запись.Идентификатор);
	Сообщение.Вставить("Отправитель", Запись.Отправитель);
	Сообщение.Вставить("Заголовки", Запись.Заголовки);
	Сообщение.Вставить("ТипСообщения", Запись.content_type);
	Сообщение.Вставить("ТелоСообщения", Запись.Сообщение.Получить());
	Сообщение.Вставить("УзелОбмена", Запись.УзелОбмена);
	Сообщение.Вставить("КоличествоПопыток", Запись.КоличествоПопыток);

	Для Каждого СценарийЗагрузки Из СценарииЗагрузки Цикл
		КОД_ДиспетчерЗагрузкиСообщений.ВыполнитьСценарийЗагрузки(Сообщение, СценарийЗагрузки);
	КонецЦикла;

КонецПроцедуры

// Вызывается после отката загрузки. Ошибка записи в регистр прерывает обработку.
Процедура ЗаписатьОшибку(КлючЗаписи, ТекстОшибки)

	Менеджер = РегистрыСведений.КОД_ОшибкиЗагрузкиСообщений;
	НачатьТранзакцию();

	Попытка
		Менеджер.ЗаблокироватьЗапись(КлючЗаписи);
		Запись = Менеджер.ПрочитатьЗапись(КлючЗаписи);

		Если Запись <> Неопределено Тогда
			// Ручная попытка разрешена и при максимальном значении счетчика.
			Запись.КоличествоПопыток = Мин(Запись.КоличествоПопыток + 1, 9999999999);
			Запись.Ошибка = Новый ХранилищеЗначения(ТекстОшибки, Новый СжатиеДанных(9));
			Запись.Записать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
