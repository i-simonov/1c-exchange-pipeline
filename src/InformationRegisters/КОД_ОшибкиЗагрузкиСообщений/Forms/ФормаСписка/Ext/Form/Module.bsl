&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ПрочитатьТекущееСообщениеНаСервере(КлючСтроки(Элементы.Список.ТекущиеДанные));

КонецПроцедуры

&НаСервере
Процедура ПрочитатьТекущееСообщениеНаСервере(КлючЗаписи)

	Сообщение = "";
	Ошибка = "";

	Если КлючЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.КОД_ОшибкиЗагрузкиСообщений.ПрочитатьЗапись(КлючЗаписи);

	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Запись.Сообщение <> Неопределено Тогда
		Сообщение = Запись.Сообщение.Получить();
	КонецЕсли;

	Если Запись.Ошибка <> Неопределено Тогда
		Ошибка = Запись.Ошибка.Получить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСообщение(Команда)

	Ключи = КлючиВыбранныхЗаписей();

	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗагрузитьСообщенияНаСервере(Ключи);
	ОбновитьСписокИСообщение();
	Сообщить(Итог);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьСообщенияНаСервере(Ключи)

	Успешно = 0;
	СОшибками = 0;
	Пропущено = 0;

	Для Каждого КлючЗаписи Из Ключи Цикл
		Результат = КОД_ПовторнаяЗагрузкаСообщений.ОбработатьЗапись(КлючЗаписи);

		Если Результат.Успешно Тогда
			Успешно = Успешно + 1;
		ИначеЕсли Результат.Пропущено Тогда
			Пропущено = Пропущено + 1;
		Иначе
			СОшибками = СОшибками + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон("Загружено: %1. С ошибками: %2. Уже удалено: %3.", Успешно, СОшибками, Пропущено);

КонецФункции

&НаКлиенте
Процедура СохранитьИзмененноеСообщение(Команда)

	КлючЗаписи = КлючСтроки(Элементы.Список.ТекущиеДанные);

	Если КлючЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СохранитьИзмененноеСообщениеНаСервере(КлючЗаписи);
	ОбновитьСписокИСообщение();

КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененноеСообщениеНаСервере(КлючЗаписи)

	РегистрыСведений.КОД_ОшибкиЗагрузкиСообщений.ИзменитьСообщение(КлючЗаписи, Сообщение);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВсеСообщения(Команда)

	ЗагрузитьВсеСообщенияНаСервере();
	ОбновитьСписокИСообщение();
	Сообщить("Обработка завершена. Записи на контроле и с исчерпанным лимитом попыток пропущены.");

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьВсеСообщенияНаСервере()

	КОД_ПовторнаяЗагрузкаСообщений.ОбработатьРегистр();

КонецПроцедуры

&НаКлиенте
Процедура ВзятьНаКонтроль(Команда)

	Ключи = КлючиВыбранныхЗаписей();

	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВзятьНаКонтрольНаСервере(Ключи);
	ОбновитьСписокИСообщение();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВзятьНаКонтрольНаСервере(Ключи)

	Ответственный = ИмяПользователя();

	Для Каждого КлючЗаписи Из Ключи Цикл
		РегистрыСведений.КОД_ОшибкиЗагрузкиСообщений.ВзятьНаКонтроль(КлючЗаписи, Ответственный);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция КлючСтроки(ДанныеСтроки)

	Если ДанныеСтроки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ДанныеСтроки.Свойство("ГруппировкаСтроки") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("НомерСообщения, Идентификатор, Сценарий, content_type, УзелОбмена",
		ДанныеСтроки.НомерСообщения, ДанныеСтроки.Идентификатор,
		ДанныеСтроки.Сценарий, ДанныеСтроки.content_type, ДанныеСтроки.УзелОбмена);

КонецФункции

&НаКлиенте
Функция КлючиВыбранныхЗаписей()

	Ключи = Новый Массив;

	Для Каждого ИдентификаторСтроки Из Элементы.Список.ВыделенныеСтроки Цикл
		КлючЗаписи = КлючСтроки(Элементы.Список.ДанныеСтроки(ИдентификаторСтроки));

		Если КлючЗаписи <> Неопределено Тогда
			Ключи.Добавить(КлючЗаписи);
		КонецЕсли;
	КонецЦикла;

	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		КлючЗаписи = КлючСтроки(Элементы.Список.ТекущиеДанные);

		Если КлючЗаписи <> Неопределено Тогда
			Ключи.Добавить(КлючЗаписи);
		КонецЕсли;
	КонецЕсли;

	Возврат Ключи;

КонецФункции

&НаКлиенте
Процедура ОбновитьСписокИСообщение()

	Элементы.Список.Обновить();
	ПрочитатьТекущееСообщениеНаСервере(КлючСтроки(Элементы.Список.ТекущиеДанные));

КонецПроцедуры
