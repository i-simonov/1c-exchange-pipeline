#Область ОписаниеПеременных
Перем СледующийОбработчик;
#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции

// Этап после Router, до связанной регистрации и Mapper.
// Сохраняет структуру ВТ_СсылкиПоУзлам и удаляет только маршруты к отправителю.
// Не добавляет получателей и не затрагивает ранее зарегистрированные изменения.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	МенеджерВременныхТаблиц = Контекст.Выполнение.МенеджерВременныхТаблиц;

	Если НЕ КОД_ДиспетчерРегистрацииКОбмену.ВременнаяТаблицаСуществует(
		МенеджерВременныхТаблиц, "ВТ_СсылкиПоУзлам") Тогда
		ВызватьИсключение "Исключение отправителя: отсутствует ВТ_СсылкиПоУзлам. Выполните маршрутизацию.";
	КонецЕсли;

	Отправитель = КОД_ДиспетчерРегистрацииКОбмену.ИсключаемыйОтправитель(Контекст);

	Если ЗначениеЗаполнено(Отправитель) Тогда
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Отправитель", Отправитель);

		Запрос.Текст =
			"ВЫБРАТЬ Маршруты.*
			|ПОМЕСТИТЬ ВТ_КОД_МаршрутыБезОтправителя
			|ИЗ ВТ_СсылкиПоУзлам КАК Маршруты
			|ГДЕ Маршруты.Узел <> &Отправитель
			|;
			|УНИЧТОЖИТЬ ВТ_СсылкиПоУзлам
			|;
			|ВЫБРАТЬ Маршруты.*
			|ПОМЕСТИТЬ ВТ_СсылкиПоУзлам
			|ИЗ ВТ_КОД_МаршрутыБезОтправителя КАК Маршруты
			|;
			|УНИЧТОЖИТЬ ВТ_КОД_МаршрутыБезОтправителя";
		Запрос.Выполнить();
	КонецЕсли;

	Если НЕ ИзолированныйВызов И СледующийОбработчик <> Неопределено Тогда
		СледующийОбработчик.Обработать(Контекст, Вход);
	КонецЕсли;

	Возврат Вход;

КонецФункции
#КонецОбласти
