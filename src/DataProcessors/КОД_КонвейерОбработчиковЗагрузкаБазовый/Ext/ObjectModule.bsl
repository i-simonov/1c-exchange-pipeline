#Область СлужебныеПроцедурыИФункции

// Читает JSON средствами платформы. Объекты JSON возвращаются как соответствия.
Функция ПрочитатьСообщениеJSON(ТелоСообщения)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоСообщения);
	ДанныеСообщения = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат ДанныеСообщения;

КонецФункции

