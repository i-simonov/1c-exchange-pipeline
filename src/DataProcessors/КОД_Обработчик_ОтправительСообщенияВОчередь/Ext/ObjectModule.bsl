// Устанавливает следующий обработчик цепочки или возвращает ранее установленный.
//
// Параметры:
//  Обработчик - ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
//
// Возвращаемое значение:
//  ОбработкаОбъект, Неопределено - следующий обработчик цепочки.
Функция Следующий(Обработчик = Неопределено) Экспорт

	Если Обработчик <> Неопределено Тогда
		СледующийОбработчик = Обработчик;
	КонецЕсли;

	Возврат СледующийОбработчик;

КонецФункции

// Записывает сообщения для всех получателей во внутреннюю исходящую очередь.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Вход - ФиксированнаяСтруктура, Неопределено - подготовленное сообщение.
Функция Обработать(Контекст, Вход = Неопределено) Экспорт

	// Флаг относится только к этому вызову и сбрасывается до выполнения его логики.
	ИзолированныйВызов = Контекст.Выполнение.ИзолированныйВызов;
	Контекст.Выполнение.Вставить("ИзолированныйВызов", Ложь);

	Если Вход = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	НаборОчереди = РегистрыСведений.КОД_ИсходящаяОчередьСообщений.СоздатьНаборЗаписей();

	Для Каждого Получатель Из Вход.Получатели Цикл

		ЗаписьОчередь = НаборОчереди.Добавить();
		ЗаписьОчередь.Отправитель = КодЭтогоУзлаПоУзлуПланаОбмена(Получатель);
		ЗаписьОчередь.ТипОперации = Вход.Заголовки["sync_type"];
		ЗаписьОчередь.Заголовки = ЗаписатьJSON_(Вход.Заголовки);
		ЗаписьОчередь.МоментВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ЗаписьОчередь.Идентификатор = Новый УникальныйИдентификатор;
		ЗаписьОчередь.ДатаВремя = ТекущаяДата();
		ЗаписьОчередь.Получатель = Получатель.Код;
		ЗаписьОчередь.ТипСообщения = Контекст.Вход.ОбъектМетаданных.ПолноеИмя();
		ЗаписьОчередь.ТелоСообщения = Вход.Тело;

	КонецЦикла;

	Если НаборОчереди.Количество() > 0 Тогда
		НаборОчереди.Записать(Ложь);
	КонецЕсли;

	Если НЕ ИзолированныйВызов Тогда
		ПередатьДругому(Контекст, Вход);
	КонецЕсли;

	Возврат Вход;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КодЭтогоУзлаПоУзлуПланаОбмена(Узел) Экспорт

	Возврат ПолучитьКодЭтогоУзлаДляПланаОбмена(Узел.Метаданные().Имя);

КонецФункции

Функция ПолучитьКодЭтогоУзлаДляПланаОбмена(ИмяПланаОбмена) Экспорт

	Возврат ПолучитьЭтотУзелПланаОбмена(ИмяПланаОбмена).Код;

КонецФункции

Функция ПолучитьЭтотУзелПланаОбмена(ИмяПланаОбмена) Экспорт

	Возврат ПланыОбмена[ИмяПланаОбмена].ЭтотУзел();

КонецФункции

Функция ЗаписатьJSON_(Значение, ПараметрыЗаписи = Неопределено)

	Если ПараметрыЗаписи = Неопределено Тогда
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Значение, , "ПреобразованиеJSON", ЭтотОбъект);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ПреобразованиеJSON(Знач Свойство, Значение, ДопПараметры, Отказ) Экспорт

	Возврат XMLСтрока(Значение);

КонецФункции

// Передает управление следующему обработчику цепочки.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  Выход - Произвольный - результат текущего обработчика.
Процедура ПередатьДругому(Контекст, Выход = Неопределено)

	Если СледующийОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СледующийОбработчик.Обработать(Контекст, Выход);

КонецПроцедуры

#КонецОбласти
