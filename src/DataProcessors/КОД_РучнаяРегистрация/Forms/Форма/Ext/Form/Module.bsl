
&НаСервере
Процедура ЗаполнитьПоМетаданнымНаСервере()
	
	ТаблицаПланОбъектыОбработчики = новый ТаблицаЗначений;
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("ПланОбмена");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("ОбъектТип");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Объект");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Конвейер");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Обработчик");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Сценарий");
	
	СоответствиеПлановОбменаРеестрам = КОД_ДиспетчерРегистрацииКОбмену.РеестрыСценариевПоПланамОбмена();
	
	Для каждого ОбъектМетаданныхПланКИЗ Из СоответствиеПлановОбменаРеестрам Цикл
		
		ОбработкаРеестрМета = СоответствиеПлановОбменаРеестрам[ОбъектМетаданныхПланКИЗ.Ключ];
		СоотвРеестрПоПлану = КОД_ДиспетчерРегистрацииКОбмену.ПолучитьОбъектОбработки(ОбработкаРеестрМета).РеестрКонвейеровРегистрации();
		
		Для каждого ОбъектМетаданныхКИЗ Из СоотвРеестрПоПлану Цикл
			
			Для каждого СтруктураКонвейер Из ОбъектМетаданныхКИЗ.Значение Цикл
			
			 	Для каждого Обработчик Из СтруктураКонвейер.Обработчики Цикл
			 
			 	     нстр = ТаблицаПланОбъектыОбработчики.Добавить();
					 нстр.ПланОбмена = ОбъектМетаданныхПланКИЗ.Ключ;
					 нстр.Объект = ОбъектМетаданныхКИЗ.Ключ;
					 нстр.ОбъектТип = СтрРазделить(ОбъектМетаданныхКИЗ.Ключ.ПолноеИмя(), ".")[0];
					 нстр.Конвейер = СтруктураКонвейер.Конвейер;
					 нстр.Обработчик = Обработчик;
					 нстр.Сценарий = СтруктураКонвейер;			 
			 	КонецЦикла; 
				
			
			КонецЦикла; 
		
		КонецЦикла;
		
	КонецЦикла;
		
	ТаблицаПланОбъектыОбработчики.Сортировать("ПланОбмена, ОбъектТип, Объект, Конвейер, Обработчик");
	
	соотвОбщийТипПараметры = Новый Соответствие;

	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 3, 4, "Справочник", НСтр("ru = 'Справочники'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 5, 6, "Последовательность", НСтр("ru = 'Последовательности'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 7, 8, "Документ", НСтр("ru = 'Документы'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 9, 10, "ПланВидовХарактеристик", НСтр("ru = 'Планы видов характеристик'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 11, 12, "ПланСчетов", НСтр("ru = 'Планы счетов'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 13, 14, "ПланВидовРасчета", НСтр("ru = 'Планы видов расчета'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 15, 16, "РегистрСведений", НСтр("ru = 'Регистры сведений'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 17, 18, "РегистрНакопления", НСтр("ru = 'Регистры накопления'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 19, 20, "РегистрБухгалтерии", НСтр("ru = 'Регистры бухгалтерии'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 21, 22, "РегистрРасчета", НСтр("ru = 'Регистры расчета'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 23, 24, "БизнесПроцесс", НСтр("ru = 'Бизнес-процессы'"));
	ДобавитьПараметрыТипаМетаданных(соотвОбщийТипПараметры, 25, 26, "Задача", НСтр("ru = 'Задачи'"));
	
	ТаблицаКонвейеров = ДанныеФормыВЗначение(Конвейеры, Тип("ТаблицаЗначений"));
	ТаблицаОбработчиков = ДанныеФормыВЗначение(Обработчики, Тип("ТаблицаЗначений"));

	ТаблицаКонвейеров.Очистить();
	ТаблицаОбработчиков.Очистить();

	ДеревоОбъектовМетаданных = ДанныеФормыВЗначение(ОбъектыМетаданных, Тип("ДеревоЗначений"));
	ДеревоОбъектовМетаданных.Строки.Очистить();

	соотвСтрокиПланов = Новый Соответствие;
	соотвСтрокиТипов = Новый Соответствие;
	соотвСтрокиОбъектов = Новый Соответствие;
	соотвСтрокиКонвейеров = Новый Соответствие;

	Для каждого СтрокаОбъекта Из ТаблицаПланОбъектыОбработчики Цикл
		
		ИмяПланаОбмена = СтрокаОбъекта.ПланОбмена.Имя;
		ПолноеИмяПланаОбмена = СтрокаОбъекта.ПланОбмена.ПолноеИмя();
		ПолноеИмяОбъекта = СтрокаОбъекта.Объект.ПолноеИмя();
		
		// План обмена
		
		Если соотвСтрокиПланов[ПолноеИмяПланаОбмена] = Неопределено Тогда
			
			СтрокаПлана = ДеревоОбъектовМетаданных.Строки.Добавить();
			СтрокаПлана.ОбъектМетаданных = ИмяПланаОбмена;
			СтрокаПлана.ПланОбмена = ИмяПланаОбмена;
			СтрокаПлана.Наименование = ИмяПланаОбмена;
			СтрокаПлана.МетаПолноеИмя = ПолноеИмяПланаОбмена;
			СтрокаПлана.Идентификатор = Строка(Новый УникальныйИдентификатор);
			
			соотвСтрокиПланов[ПолноеИмяПланаОбмена] = СтрокаПлана;
			
		Иначе
			
			СтрокаПлана = соотвСтрокиПланов[ПолноеИмяПланаОбмена];
			
		КонецЕсли;
		
		// Группа типа метаданных
		
		КлючТипа = ПолноеИмяПланаОбмена + "|" + СтрокаОбъекта.ОбъектТип;
		
		Если соотвСтрокиТипов[КлючТипа] = Неопределено Тогда
			
			ПараметрыТипа = соотвОбщийТипПараметры[СтрокаОбъекта.ОбъектТип];
			
			СтрокаТипа = СтрокаПлана.Строки.Добавить();
			СтрокаТипа.ОбъектМетаданных = ПараметрыТипа.ПредставлениеМета;
			СтрокаТипа.ИндексКартинки = ПараметрыТипа.ИндексКартинкиУзлов;
			СтрокаТипа.ПланОбмена = ИмяПланаОбмена;
			СтрокаТипа.Наименование = ПараметрыТипа.ПредставлениеМета;
			СтрокаТипа.МетаПолноеИмя = ПараметрыТипа.ИмяМета;
			СтрокаТипа.Идентификатор = Строка(Новый УникальныйИдентификатор);
			
			соотвСтрокиТипов[КлючТипа] = СтрокаТипа;
			
		Иначе
			
			СтрокаТипа = соотвСтрокиТипов[КлючТипа];
			
		КонецЕсли;
		
		// Объект метаданных
		
		КлючОбъекта = ПолноеИмяПланаОбмена + "|" + ПолноеИмяОбъекта;
		
		Если соотвСтрокиОбъектов[КлючОбъекта] = Неопределено Тогда
			
			ПараметрыТипа = соотвОбщийТипПараметры[СтрокаОбъекта.ОбъектТип];
			
			СтрокаДереваОбъекта = СтрокаТипа.Строки.Добавить();
			СтрокаДереваОбъекта.ОбъектМетаданных = СтрокаОбъекта.Объект.Имя;
			СтрокаДереваОбъекта.ИндексКартинки = ПараметрыТипа.ИндексКартинки;
			СтрокаДереваОбъекта.ПланОбмена = ИмяПланаОбмена;
			СтрокаДереваОбъекта.Наименование = СтрокаОбъекта.Объект.Синоним;
			СтрокаДереваОбъекта.МетаПолноеИмя = ПолноеИмяОбъекта;
			СтрокаДереваОбъекта.Идентификатор = Строка(Новый УникальныйИдентификатор);
			
			соотвСтрокиОбъектов[КлючОбъекта] = СтрокаДереваОбъекта;
			
		Иначе
			
			СтрокаДереваОбъекта = соотвСтрокиОбъектов[КлючОбъекта];
			
		КонецЕсли;
		
		// Конвейер
		
		КлючКонвейера = КлючОбъекта + "|" + СтрокаОбъекта.Конвейер;
		
		Если соотвСтрокиКонвейеров[КлючКонвейера] = Неопределено Тогда
			
			СтрокаКонвейера = ТаблицаКонвейеров.Добавить();
			СтрокаКонвейера.Конвейер = СтрокаОбъекта.Конвейер;
			СтрокаКонвейера.КонвейерИмя = СтрокаОбъекта.Конвейер.ПолноеИмя();
			СтрокаКонвейера.Пометка = Истина;
			СтрокаКонвейера.ПланОбмена = ИмяПланаОбмена;
			СтрокаКонвейера.Идентификатор = Строка(Новый УникальныйИдентификатор);
			СтрокаКонвейера.ИдентификаторДерево = СтрокаДереваОбъекта.Идентификатор;
			СтрокаКонвейера.Сценарий = ПоместитьВоВременноеХранилище(СтрокаОбъекта.Сценарий);
			
			соотвСтрокиКонвейеров[КлючКонвейера] = СтрокаКонвейера;
			
		Иначе
			
			СтрокаКонвейера = соотвСтрокиКонвейеров[КлючКонвейера];
			
		КонецЕсли;
		
		// Обработчик
		
		СтрокаОбработчика = ТаблицаОбработчиков.Добавить();
		СтрокаОбработчика.Конвейер = СтрокаОбъекта.Конвейер;
		СтрокаОбработчика.Обработчик = СтрокаОбъекта.Обработчик;
		СтрокаОбработчика.ОбработчикИмя = СтрокаОбъекта.Обработчик.ПолноеИмя();
		СтрокаОбработчика.ПланОбмена = ИмяПланаОбмена;
		СтрокаОбработчика.ИдентификаторКонвейеры = СтрокаКонвейера.Идентификатор;
		СтрокаОбработчика.Пометка = Истина;
		
	КонецЦикла;

	ЗначениеВДанныеФормы(ДеревоОбъектовМетаданных, ОбъектыМетаданных);
	ЗначениеВДанныеФормы(ТаблицаКонвейеров, Конвейеры);
	ЗначениеВДанныеФормы(ТаблицаОбработчиков, Обработчики);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоМетаданным(Команда)
	ЗаполнитьПоМетаданнымНаСервере();
КонецПроцедуры

Процедура ДобавитьПараметрыТипаМетаданных(
	соотвОбщийТипПараметры,
	ИндексКартинки,
	ИндексКартинкиУзлов,
	ИмяМета,
	ПредставлениеМета)

	стрПараметрыСтроки = Новый Структура;
	стрПараметрыСтроки.Вставить("ИндексКартинки", ИндексКартинки);
	стрПараметрыСтроки.Вставить("ИндексКартинкиУзлов", ИндексКартинкиУзлов);
	стрПараметрыСтроки.Вставить("ИмяМета", ИмяМета);
	стрПараметрыСтроки.Вставить("ПредставлениеМета", ПредставлениеМета);

	соотвОбщийТипПараметры[ИмяМета] = стрПараметрыСтроки;

КонецПроцедуры

