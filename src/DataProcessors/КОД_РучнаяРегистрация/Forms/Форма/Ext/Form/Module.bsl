#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьПоМетаданнымНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектыМетаданных

&НаКлиенте
Процедура ОбъектыМетаданныхПриАктивизацииСтроки(Элемент)
	
	ОбновитьКаскадныеОтборы();
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКонвейеры

&НаКлиенте
Процедура КонвейерыПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрокаОбъекта = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	ТекущаяСтрокаКонвейера = Элемент.ТекущиеДанные;
	
	Если ТекущаяСтрокаОбъекта = Неопределено
		Или ТекущаяСтрокаКонвейера = Неопределено
		Или ТекущаяСтрокаКонвейера.ИдентификаторДерево <> ТекущаяСтрокаОбъекта.Идентификатор Тогда
		
		УстановитьОтборОбработчиковПоКонвейеру();
		Возврат;
		
	КонецЕсли;
	
	УстановитьОтборОбработчиковПоКонвейеру(ТекущаяСтрокаКонвейера);
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокСсылок

&НаКлиенте
Процедура СписокСсылокОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбработкаВыбораДанных(Элемент, ВыбранноеЗначение);
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоМетаданным(Команда)
	
	ЗаполнитьПоМетаданнымНаСервере();
	ОбновитьКаскадныеОтборы();
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьРегистрациюОтбор(Команда)
	
	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекПараметры = Новый Структура("ДействиеВыбора, ИмяТаблицы", Истина, ТекущиеДанные.МетаПолноеИмя);
	ОткрытьФорму("Обработка.КОД_РучнаяРегистрация.Форма.ВыборОбъектовОтбором", ТекПараметры, Элементы.СписокСсылок);
	
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьРегистрацию(Команда)
	
	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	
	Для Каждого СтрокаСсылки Из СписокСсылок Цикл
		
		Если ЗначениеЗаполнено(СтрокаСсылки.Ссылка) Тогда
			МассивСсылок.Добавить(СтрокаСсылки.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РезультатРегистрации = ВыполнитьРегистрациюПоСсылкамНаСервере(
		МассивСсылок, ТекущиеДанные.МетаПолноеИмя, ТекущиеДанные.Идентификатор,
		ТекущиеДанные.ПланОбмена);
	
	Если ТипЗнч(РезультатРегистрации) = Тип("ТабличныйДокумент") Тогда
		РезультатРегистрации.Показать(НСтр("ru = 'Результаты регистрации'"));
	ИначеЕсли ЗначениеЗаполнено(РезультатРегистрации) Тогда
		ПоказатьПредупреждение(, РезультатРегистрации);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеПоМетаданным

&НаСервере
Процедура ЗаполнитьПоМетаданнымНаСервере()
	
	ТаблицаПланОбъектыОбработчики = Новый ТаблицаЗначений;
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("ПланОбмена");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("ОбъектТип");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Объект");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Конвейер");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Обработчик");
	ТаблицаПланОбъектыОбработчики.Колонки.Добавить("Сценарий");
	
	СоответствиеПлановОбменаРеестрам = КОД_ДиспетчерРегистрацииКОбмену.РеестрыСценариевПоПланамОбмена();
	
	Для Каждого ОбъектМетаданныхПланКИЗ Из СоответствиеПлановОбменаРеестрам Цикл
		
		ОбработкаРеестрМета = СоответствиеПлановОбменаРеестрам[ОбъектМетаданныхПланКИЗ.Ключ];
		СоотвРеестрПоПлану = КОД_ДиспетчерРегистрацииКОбмену.ПолучитьОбъектОбработки(ОбработкаРеестрМета).РеестрКонвейеровРегистрации();
		
		Для Каждого ОбъектМетаданныхКИЗ Из СоотвРеестрПоПлану Цикл
			
			Для Каждого СтруктураКонвейер Из ОбъектМетаданныхКИЗ.Значение Цикл
				
				Для Каждого Обработчик Из СтруктураКонвейер.Обработчики Цикл
					
					НоваяСтрока = ТаблицаПланОбъектыОбработчики.Добавить();
					НоваяСтрока.ПланОбмена = ОбъектМетаданныхПланКИЗ.Ключ;
					НоваяСтрока.Объект = ОбъектМетаданныхКИЗ.Ключ;
					НоваяСтрока.ОбъектТип = СтрРазделить(ОбъектМетаданныхКИЗ.Ключ.ПолноеИмя(), ".")[0];
					НоваяСтрока.Конвейер = СтруктураКонвейер.Конвейер;
					НоваяСтрока.Обработчик = Обработчик;
					НоваяСтрока.Сценарий = СтруктураКонвейер;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СоотвОбщийТипПараметры = Новый Соответствие;
	
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 3, 4, "Справочник", НСтр("ru = 'Справочники'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 5, 6, "Последовательность", НСтр("ru = 'Последовательности'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 7, 8, "Документ", НСтр("ru = 'Документы'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 9, 10, "ПланВидовХарактеристик", НСтр("ru = 'Планы видов характеристик'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 11, 12, "ПланСчетов", НСтр("ru = 'Планы счетов'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 13, 14, "ПланВидовРасчета", НСтр("ru = 'Планы видов расчета'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 15, 16, "РегистрСведений", НСтр("ru = 'Регистры сведений'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 17, 18, "РегистрНакопления", НСтр("ru = 'Регистры накопления'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 19, 20, "РегистрБухгалтерии", НСтр("ru = 'Регистры бухгалтерии'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 21, 22, "РегистрРасчета", НСтр("ru = 'Регистры расчета'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 23, 24, "БизнесПроцесс", НСтр("ru = 'Бизнес-процессы'"));
	ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, 25, 26, "Задача", НСтр("ru = 'Задачи'"));
	
	ТаблицаКонвейеров = ДанныеФормыВЗначение(Конвейеры, Тип("ТаблицаЗначений"));
	ТаблицаОбработчиков = ДанныеФормыВЗначение(Обработчики, Тип("ТаблицаЗначений"));
	
	ТаблицаКонвейеров.Очистить();
	ТаблицаОбработчиков.Очистить();
	
	ДеревоОбъектовМетаданных = ДанныеФормыВЗначение(ОбъектыМетаданных, Тип("ДеревоЗначений"));
	ДеревоОбъектовМетаданных.Строки.Очистить();
	
	СоотвСтрокиПланов = Новый Соответствие;
	СоотвСтрокиТипов = Новый Соответствие;
	СоотвСтрокиОбъектов = Новый Соответствие;
	СоотвСтрокиКонвейеров = Новый Соответствие;
	
	Для Каждого СтрокаОбъекта Из ТаблицаПланОбъектыОбработчики Цикл
		
		ИмяПланаОбмена = СтрокаОбъекта.ПланОбмена.Имя;
		ПолноеИмяПланаОбмена = СтрокаОбъекта.ПланОбмена.ПолноеИмя();
		ПолноеИмяОбъекта = СтрокаОбъекта.Объект.ПолноеИмя();
		
		// План обмена.
		
		Если СоотвСтрокиПланов[ПолноеИмяПланаОбмена] = Неопределено Тогда
			
			СтрокаПлана = ДеревоОбъектовМетаданных.Строки.Добавить();
			СтрокаПлана.ОбъектМетаданных = ИмяПланаОбмена;
			СтрокаПлана.ПланОбмена = ИмяПланаОбмена;
			СтрокаПлана.Наименование = ИмяПланаОбмена;
			СтрокаПлана.МетаПолноеИмя = ПолноеИмяПланаОбмена;
			СтрокаПлана.Идентификатор = Строка(Новый УникальныйИдентификатор);
			
			СоотвСтрокиПланов[ПолноеИмяПланаОбмена] = СтрокаПлана;
			
		Иначе
			СтрокаПлана = СоотвСтрокиПланов[ПолноеИмяПланаОбмена];
		КонецЕсли;
		
		// Группа типа метаданных.
		
		КлючТипа = ПолноеИмяПланаОбмена + "|" + СтрокаОбъекта.ОбъектТип;
		
		Если СоотвСтрокиТипов[КлючТипа] = Неопределено Тогда
			
			ПараметрыТипа = СоотвОбщийТипПараметры[СтрокаОбъекта.ОбъектТип];
			
			СтрокаТипа = СтрокаПлана.Строки.Добавить();
			СтрокаТипа.ОбъектМетаданных = ПараметрыТипа.ПредставлениеМета;
			СтрокаТипа.ИндексКартинки = ПараметрыТипа.ИндексКартинкиУзлов;
			СтрокаТипа.ПланОбмена = ИмяПланаОбмена;
			СтрокаТипа.Наименование = ПараметрыТипа.ПредставлениеМета;
			СтрокаТипа.МетаПолноеИмя = ПараметрыТипа.ИмяМета;
			СтрокаТипа.Идентификатор = Строка(Новый УникальныйИдентификатор);
			
			СоотвСтрокиТипов[КлючТипа] = СтрокаТипа;
			
		Иначе
			СтрокаТипа = СоотвСтрокиТипов[КлючТипа];
		КонецЕсли;
		
		// Объект метаданных.
		
		КлючОбъекта = ПолноеИмяПланаОбмена + "|" + ПолноеИмяОбъекта;
		
		Если СоотвСтрокиОбъектов[КлючОбъекта] = Неопределено Тогда
			
			ПараметрыТипа = СоотвОбщийТипПараметры[СтрокаОбъекта.ОбъектТип];
			
			СтрокаДереваОбъекта = СтрокаТипа.Строки.Добавить();
			СтрокаДереваОбъекта.ОбъектМетаданных = СтрокаОбъекта.Объект.Имя;
			СтрокаДереваОбъекта.ИндексКартинки = ПараметрыТипа.ИндексКартинки;
			СтрокаДереваОбъекта.ПланОбмена = ИмяПланаОбмена;
			СтрокаДереваОбъекта.Наименование = СтрокаОбъекта.Объект.Синоним;
			СтрокаДереваОбъекта.МетаПолноеИмя = ПолноеИмяОбъекта;
			СтрокаДереваОбъекта.Идентификатор = Строка(Новый УникальныйИдентификатор);
			
			СоотвСтрокиОбъектов[КлючОбъекта] = СтрокаДереваОбъекта;
			
		Иначе
			СтрокаДереваОбъекта = СоотвСтрокиОбъектов[КлючОбъекта];
		КонецЕсли;
		
		// Конвейер.
		
		ПолноеИмяКонвейера = СтрокаОбъекта.Конвейер.ПолноеИмя();
		КлючКонвейера = КлючОбъекта + "|" + ПолноеИмяКонвейера;
		
		Если СоотвСтрокиКонвейеров[КлючКонвейера] = Неопределено Тогда
			
			СтрокаКонвейера = ТаблицаКонвейеров.Добавить();
			СтрокаКонвейера.Конвейер = СтрокаОбъекта.Конвейер;
			СтрокаКонвейера.КонвейерИмя = ПолноеИмяКонвейера;
			СтрокаКонвейера.Пометка = Истина;
			СтрокаКонвейера.ПланОбмена = ИмяПланаОбмена;
			СтрокаКонвейера.Идентификатор = Строка(Новый УникальныйИдентификатор);
			СтрокаКонвейера.ИдентификаторДерево = СтрокаДереваОбъекта.Идентификатор;
			СтрокаКонвейера.Сценарий = ПоместитьВоВременноеХранилище(СтрокаОбъекта.Сценарий);
			
			СоотвСтрокиКонвейеров[КлючКонвейера] = СтрокаКонвейера;
			
		Иначе
			СтрокаКонвейера = СоотвСтрокиКонвейеров[КлючКонвейера];
		КонецЕсли;
		
		// Обработчик.
		
		СтрокаОбработчика = ТаблицаОбработчиков.Добавить();
		СтрокаОбработчика.Конвейер = СтрокаОбъекта.Конвейер;
		СтрокаОбработчика.Обработчик = СтрокаОбъекта.Обработчик;
		СтрокаОбработчика.ОбработчикИмя = СтрокаОбъекта.Обработчик.ПолноеИмя();
		СтрокаОбработчика.ПланОбмена = ИмяПланаОбмена;
		СтрокаОбработчика.ИдентификаторКонвейеры = СтрокаКонвейера.Идентификатор;
		СтрокаОбработчика.Пометка = Истина;
		
	КонецЦикла;
	
	ЗначениеВДанныеФормы(ДеревоОбъектовМетаданных, ОбъектыМетаданных);
	ЗначениеВДанныеФормы(ТаблицаКонвейеров, Конвейеры);
	ЗначениеВДанныеФормы(ТаблицаОбработчиков, Обработчики);
	
КонецПроцедуры


&НаСервере
Процедура ДобавитьПараметрыТипаМетаданных(СоотвОбщийТипПараметры, ИндексКартинки, ИндексКартинкиУзлов, ИмяМета, ПредставлениеМета)
	
	СтрПараметрыСтроки = Новый Структура;
	СтрПараметрыСтроки.Вставить("ИндексКартинки", ИндексКартинки);
	СтрПараметрыСтроки.Вставить("ИндексКартинкиУзлов", ИндексКартинкиУзлов);
	СтрПараметрыСтроки.Вставить("ИмяМета", ИмяМета);
	СтрПараметрыСтроки.Вставить("ПредставлениеМета", ПредставлениеМета);
	
	СоотвОбщийТипПараметры[ИмяМета] = СтрПараметрыСтроки;
	
КонецПроцедуры


#КонецОбласти

#Область КаскадныеОтборы

&НаКлиенте
Процедура УстановитьОтборСтрокТаблицы(ЭлементТаблицы, ИмяПоля, ЗначениеОтбора)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить(ИмяПоля, ЗначениеОтбора);
	ЭлементТаблицы.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
КонецПроцедуры


&НаКлиенте
Функция НесуществующийИдентификатор()
	
	// Идентификаторы строк создаются как UUID.
	// Новый UUID гарантированно не совпадет с имеющимися строками.
	Возврат Строка(Новый УникальныйИдентификатор);
	
КонецФункции


&НаКлиенте
Процедура УстановитьОтборОбработчиковПоКонвейеру(СтрокаКонвейера = Неопределено)
	
	Если СтрокаКонвейера = Неопределено Тогда
		УстановитьОтборСтрокТаблицы(Элементы.Обработчики, "ИдентификаторКонвейеры", НесуществующийИдентификатор());
		Возврат;
	КонецЕсли;
	
	УстановитьОтборСтрокТаблицы(Элементы.Обработчики, "ИдентификаторКонвейеры", СтрокаКонвейера.Идентификатор);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьКаскадныеОтборы()
	
	ТекущаяСтрокаОбъекта = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	
	Если ТекущаяСтрокаОбъекта = Неопределено Тогда
		УстановитьОтборСтрокТаблицы(Элементы.Конвейеры, "ИдентификаторДерево", НесуществующийИдентификатор());
		УстановитьОтборОбработчиковПоКонвейеру();
		Возврат;
	КонецЕсли;
	
	ИдентификаторДерева = ТекущаяСтрокаОбъекта.Идентификатор;
	УстановитьОтборСтрокТаблицы(Элементы.Конвейеры, "ИдентификаторДерево", ИдентификаторДерева);
	
	ПерваяСтрокаКонвейера = Неопределено;
	
	Для Каждого СтрокаКонвейера Из Конвейеры Цикл
		
		Если СтрокаКонвейера.ИдентификаторДерево = ИдентификаторДерева Тогда
			ПерваяСтрокаКонвейера = СтрокаКонвейера;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПерваяСтрокаКонвейера = Неопределено Тогда
		УстановитьОтборОбработчиковПоКонвейеру();
	Иначе
		Элементы.Конвейеры.ТекущаяСтрока = ПерваяСтрокаКонвейера.ПолучитьИдентификатор();
		УстановитьОтборОбработчиковПоКонвейеру(ПерваяСтрокаКонвейера);
	КонецЕсли;
	
	СписокСсылок.Очистить();
	
КонецПроцедуры


#КонецОбласти

#Область ВыборОбъектов

&НаКлиенте
Процедура ОбработкаВыбораДанных(ТаблицаФормы, ВыбранноеЗначение)
	
	Ссылка = Неопределено;
	Тип = ТипЗнч(ВыбранноеЗначение);
	
	Если Тип = Тип("Структура") Тогда
		
		Если Не (ВыбранноеЗначение.Свойство("ИмяТаблицы")
			И ВыбранноеЗначение.Свойство("ДействиеВыбора")
			И ВыбранноеЗначение.Свойство("ДанныеВыбора")) Тогда
			
			Возврат;
			
		КонецЕсли;
		
		ИмяТаблицы = ВыбранноеЗначение.ИмяТаблицы;
		Действие = ВыбранноеЗначение.ДействиеВыбора;
		Данные = ВыбранноеЗначение.ДанныеВыбора;
		
	Иначе
		
		ИмяТаблицы = Неопределено;
		Действие = Истина;
		
		Если Тип = Тип("Массив") Тогда
			Данные = ВыбранноеЗначение;
		Иначе
			Данные = Новый Массив;
			Данные.Добавить(ВыбранноеЗначение);
		КонецЕсли;
		
		Если Данные.Количество() = 1 Тогда
			Ссылка = Данные[0];
		КонецЕсли;
		
	КонецЕсли;
	
	СписокСсылок.Очистить();
	
	Для Каждого Ссылка Из Данные Цикл
		НоваяСтрока = СписокСсылок.Добавить();
		НоваяСтрока.Ссылка = Ссылка.Ссылка;
		НоваяСтрока.НеВыгружалось = Истина;
	КонецЦикла;
	
	Если Действие Тогда
		ТаблицаФормы.Обновить();
		ТаблицаФормы.ТекущаяСтрока = Ссылка;
		Возврат;
	КонецЕсли;
	
	Если Ссылка = Неопределено Тогда
		Текст = НСтр("ru = 'Отменить регистрацию выбранных объектов
			|на узле ""%1?'");
	Иначе
		Текст = НСтр("ru = 'Отменить регистрацию ""%2""
			|на узле ""%1?'");
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "%2", Ссылка);
	ЗаголовокВопроса = НСтр("ru = 'Подтверждение'");
	
	ДополнительныеПараметры = ДополнительныеПараметрыОбработкиВыбораДанных();
	ДополнительныеПараметры.Действие = Действие;
	ДополнительныеПараметры.ТаблицаФормы = ТаблицаФормы;
	ДополнительныеПараметры.Данные = Данные;
	ДополнительныеПараметры.ИмяТаблицы = ИмяТаблицы;
	ДополнительныеПараметры.Ссылка = Ссылка;
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораДанныхЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , , ЗаголовокВопроса);
	
КонецПроцедуры


&НаКлиенте
Функция ДополнительныеПараметрыОбработкиВыбораДанных()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Действие");
	ДополнительныеПараметры.Вставить("ТаблицаФормы");
	ДополнительныеПараметры.Вставить("Данные");
	ДополнительныеПараметры.Вставить("ИмяТаблицы");
	ДополнительныеПараметры.Вставить("Ссылка");
	
	Возврат ДополнительныеПараметры;
	
КонецФункции


#КонецОбласти

#Область РегистрацияОбъектов

&НаСервере
Функция ВыполнитьРегистрациюПоСсылкамНаСервере(МассивСсылок, МетаПолноеИмя, ИдентификаторДерева,
	ИмяПланаОбмена)
	
	ТабличныйДокумент.Очистить();
	
	ВыбранныеСценарии = Новый Массив;
	
	Если Не ЗначениеЗаполнено(МетаПолноеИмя)
		Или Не ЗначениеЗаполнено(ИдентификаторДерева)
		Или Не ЗначениеЗаполнено(ИмяПланаОбмена) Тогда
		Возврат НСтр("ru = 'Выберите объект в дереве выбранного плана обмена.'");
	КонецЕсли;
	
	ДеревоОбъектовМетаданных = ДанныеФормыВЗначение(ОбъектыМетаданных, Тип("ДеревоЗначений"));
	СтрокаДерева = ДеревоОбъектовМетаданных.Строки.Найти(ИдентификаторДерева, "Идентификатор", Истина);
	
	Если СтрокаДерева = Неопределено Тогда
		Возврат НСтр("ru = 'Выбранная строка не найдена. Обновите дерево и повторите выбор.'");
	КонецЕсли;
	
	Если СтрокаДерева.ПланОбмена <> ИмяПланаОбмена
		Или СтрокаДерева.МетаПолноеИмя <> МетаПолноеИмя Тогда
		Возврат НСтр("ru = 'План обмена или объект не соответствует выбранной строке дерева.'");
	КонецЕсли;
	
	Если СтрокаДерева.Строки.Количество() > 0 Тогда
		Возврат НСтр("ru = 'Выберите объект метаданных, а не план обмена или группу объектов.'");
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(МетаПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат НСтр("ru = 'Выбранный объект метаданных не найден.'");
	КонецЕсли;
	
	// План и реестр определяются выбранной строкой дерева для всей операции.
	ПланОбменаМета = Метаданные.НайтиПоПолномуИмени("ПланОбмена." + ИмяПланаОбмена);
	Если ПланОбменаМета = Неопределено Тогда
		Возврат НСтр("ru = 'Выбранный план обмена не найден.'");
	КонецЕсли;
	
	СоответствиеПлановОбменаРеестрам = КОД_ДиспетчерРегистрацииКОбмену.РеестрыСценариевПоПланамОбмена();
	ОбработкаРеестрМета = СоответствиеПлановОбменаРеестрам[ПланОбменаМета];
	Если ОбработкаРеестрМета = Неопределено Тогда
		Возврат НСтр("ru = 'Для выбранного плана обмена не подключен реестр сценариев регистрации.'");
	КонецЕсли;
	
	РеестрКонвейеров = КОД_ДиспетчерРегистрацииКОбмену.ПолучитьОбъектОбработки(
		ОбработкаРеестрМета).РеестрКонвейеровРегистрации();
	МассивСценариев = РеестрКонвейеров[ОбъектМетаданных];
	Если МассивСценариев = Неопределено Тогда
		Возврат НСтр("ru = 'Для выбранного объекта нет сценариев регистрации в выбранном плане обмена.'");
	КонецЕсли;
	
	ТаблицаКонвейеров = ДанныеФормыВЗначение(Конвейеры, Тип("ТаблицаЗначений"));
	ТаблицаОбработчиков = ДанныеФормыВЗначение(Обработчики, Тип("ТаблицаЗначений"));
	
	// Одинаковые конвейеры других планов не участвуют в текущем запуске.
	ОтборКонвейеров = Новый Структура;
	ОтборКонвейеров.Вставить("ПланОбмена", ИмяПланаОбмена);
	ОтборКонвейеров.Вставить("ИдентификаторДерево", ИдентификаторДерева);
	ОтборКонвейеров.Вставить("Пометка", Истина);
	
	ВыбранныеКонвейеры = ТаблицаКонвейеров.НайтиСтроки(ОтборКонвейеров);
	
	Для Каждого СтрокаКонвейера Из ВыбранныеКонвейеры Цикл
		
		Сценарий = Неопределено;
		
		Для Каждого ТекущийСценарий Из МассивСценариев Цикл
			
			Если ТекущийСценарий.Конвейер.ПолноеИмя() = СтрокаКонвейера.КонвейерИмя Тогда
				Сценарий = ТекущийСценарий;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Сценарий = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработчикиКонвейера = Новый Массив;
		
		// Берутся только отмеченные обработчики текущего выбранного конвейера.
		ОтборОбработчиков = Новый Структура;
		ОтборОбработчиков.Вставить("ИдентификаторКонвейеры", СтрокаКонвейера.Идентификатор);
		ОтборОбработчиков.Вставить("Пометка", Истина);
		
		ВыбранныеОбработчики = ТаблицаОбработчиков.НайтиСтроки(ОтборОбработчиков);
		
		Для Каждого СтрокаОбработчика Из ВыбранныеОбработчики Цикл
			
			ОбработчикМета = Метаданные.НайтиПоПолномуИмени(СтрокаОбработчика.ОбработчикИмя);
			
			Если ОбработчикМета <> Неопределено Тогда
				ОбработчикиКонвейера.Добавить(ОбработчикМета);
			КонецЕсли;
			
		КонецЦикла;
		
		// Если у отмеченного конвейера не выбран ни один обработчик, запускать его не нужно.
		Если ОбработчикиКонвейера.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СценарийДляВыполнения = Новый Структура(Сценарий);
		СценарийДляВыполнения.Вставить("Обработчики", ОбработчикиКонвейера);
		СценарийДляВыполнения = Новый ФиксированнаяСтруктура(СценарийДляВыполнения);
		
		ВыбранныеСценарии.Добавить(СценарийДляВыполнения);
		
	КонецЦикла;
	
	// Связанные объекты используют остальные сценарии того же выбранного плана.
	РеестрКонвейеров.Вставить(ОбъектМетаданных, ВыбранныеСценарии);
	РеестрСценариев = Новый Соответствие;
	РеестрСценариев.Вставить(ПланОбменаМета, РеестрКонвейеров);

	КонтекстРегистрации = КОД_ДиспетчерРегистрацииКОбмену.НовыйКонтекстРегистрации(
		РеестрСценариев, Неопределено, "РучнаяРегистрация");
	КОД_ДиспетчерРегистрацииКОбмену.ДобавитьЗаданиеРегистрации(
		КонтекстРегистрации, ОбъектМетаданных, МассивСсылок);
	Результаты = КОД_ДиспетчерРегистрацииКОбмену.ВыполнитьЗаданияРегистрации(КонтекстРегистрации, Истина);

	Возврат СформироватьРасшифровкуРегистрации(Результаты, МассивСсылок);
	
КонецФункции


&НаСервере
Функция СформироватьРасшифровкуРегистрации(Результаты, МассивСсылок)
	
	Если РежимРасшифровкиРегистрации <> 0 И РежимРасшифровкиРегистрации <> 1 Тогда
		Возврат "";
	КонецЕсли;
	
	// Исходные ссылки сохраняем даже без маршрутов. Остальные результаты
	// собираем отдельно как связанные объекты, объединяя повторы между конвейерами.
	УзлыПоИсходнымСсылкам = Новый Соответствие;
	Для Каждого Ссылка Из МассивСсылок Цикл
		УзлыПоИсходнымСсылкам.Вставить(Ссылка, Новый Соответствие);
	КонецЦикла;
	
	УзлыПоСвязаннымСсылкам = Новый Соответствие;
	СвязанныеСсылки = Новый Массив;
	ЗарегистрированныеИсходныеСсылки = Новый Соответствие;
	КодыУзлов = Новый Соответствие;
	
	Для Каждого ТаблицаРезультата Из Результаты Цикл
		Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаРезультата.Ссылка)
				Или Не ЗначениеЗаполнено(СтрокаРезультата.Узел) Тогда
				Продолжить;
			КонецЕсли;
			
			УзлыСсылки = УзлыПоИсходнымСсылкам.Получить(СтрокаРезультата.Ссылка);
			Если УзлыСсылки <> Неопределено Тогда
				ЗарегистрированныеИсходныеСсылки.Вставить(СтрокаРезультата.Ссылка, Истина);
			Иначе
				УзлыСсылки = УзлыПоСвязаннымСсылкам.Получить(СтрокаРезультата.Ссылка);
				Если УзлыСсылки = Неопределено Тогда
					УзлыСсылки = Новый Соответствие;
					УзлыПоСвязаннымСсылкам.Вставить(СтрокаРезультата.Ссылка, УзлыСсылки);
					СвязанныеСсылки.Добавить(СтрокаРезультата.Ссылка);
				КонецЕсли;
			КонецЕсли;
			
			УзлыСсылки.Вставить(СтрокаРезультата.Узел, Истина);
			
			Если КодыУзлов.Получить(СтрокаРезультата.Узел) = Неопределено Тогда
				КодыУзлов.Вставить(СтрокаРезультата.Узел, СокрЛП(СтрокаРезультата.Узел.Код));
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	Если РежимРасшифровкиРегистрации = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Зарегистрировано исходных объектов: %1 из %2; связанных объектов: %3. Всего узлов: %4'"),
			Формат(ЗарегистрированныеИсходныеСсылки.Количество(), "ЧГ=0;ЧН=0"),
			Формат(УзлыПоИсходнымСсылкам.Количество(), "ЧГ=0;ЧН=0"),
			Формат(СвязанныеСсылки.Количество(), "ЧГ=0;ЧН=0"),
			Формат(КодыУзлов.Количество(), "ЧГ=0;ЧН=0"));
	КонецЕсли;
	
	ЗаполнитьТабличныйДокументРегистрации(МассивСсылок, УзлыПоИсходнымСсылкам,
		СвязанныеСсылки, УзлыПоСвязаннымСсылкам, КодыУзлов);
	
	// Для отдельного окна возвращаем самостоятельный документ, а не реквизит формы.
	Возврат ТабличныйДокумент.ПолучитьОбласть(1, 1,
		ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы);
	
КонецФункции


&НаСервере
Процедура ЗаполнитьТабличныйДокументРегистрации(МассивСсылок, УзлыПоИсходнымСсылкам,
	СвязанныеСсылки, УзлыПоСвязаннымСсылкам, КодыУзлов)
	
	НомерСтроки = 0;
	ВывестиТаблицуРасшифровкиРегистрации(МассивСсылок, УзлыПоИсходнымСсылкам,
		КодыУзлов, НСтр("ru = 'Исходные объекты'"), НомерСтроки);
	
	Если СвязанныеСсылки.Количество() > 0 Тогда
		НомерСтроки = НомерСтроки + 1;
		ВывестиТаблицуРасшифровкиРегистрации(СвязанныеСсылки, УзлыПоСвязаннымСсылкам,
			КодыУзлов, НСтр("ru = 'Связанные объекты'"), НомерСтроки);
	КонецЕсли;
	
	ТабличныйДокумент.Область(1, 1, НомерСтроки, 1).ШиринаКолонки = 60;
	ТабличныйДокумент.Область(1, 2, НомерСтроки, 2).ШиринаКолонки = 35;
	ТабличныйДокумент.Область(1, 3, НомерСтроки, 3).ШиринаКолонки = 40;
	ТабличныйДокумент.Область(1, 1, НомерСтроки, 3).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
КонецПроцедуры


&НаСервере
Процедура ВывестиТаблицуРасшифровкиРегистрации(МассивСсылок, УзлыПоСсылкам,
	КодыУзлов, Заголовок, НомерСтроки)
	
	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = Заголовок;
	ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 3).Шрифт = Новый Шрифт("Arial", 12, Истина);
	
	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = НСтр("ru = 'Ссылка'");
	ТабличныйДокумент.Область(НомерСтроки, 2).Текст = НСтр("ru = 'План обмена'");
	ТабличныйДокумент.Область(НомерСтроки, 3).Текст = НСтр("ru = 'Узлы'");
	ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 3).Шрифт = Новый Шрифт("Arial", 10, Истина);
	
	ВыведенныеСсылки = Новый Соответствие;
	Для Каждого Ссылка Из МассивСсылок Цикл
		
		Если ВыведенныеСсылки.Получить(Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВыведенныеСсылки.Вставить(Ссылка, Истина);
		
		УзлыПоПланам = Новый Соответствие;
		УзлыСсылки = УзлыПоСсылкам.Получить(Ссылка);
		Если УзлыСсылки <> Неопределено Тогда
			Для Каждого УзелСсылки Из УзлыСсылки Цикл
				
				ПланОбменаМета = УзелСсылки.Ключ.Метаданные();
				ДанныеПлана = УзлыПоПланам.Получить(ПланОбменаМета.Имя);
				Если ДанныеПлана = Неопределено Тогда
					ПредставлениеПлана = ?(ЗначениеЗаполнено(ПланОбменаМета.Синоним),
						ПланОбменаМета.Синоним, ПланОбменаМета.Имя);
					ДанныеПлана = Новый Структура("ПланОбмена, КодыУзлов", ПредставлениеПлана, Новый Массив);
					УзлыПоПланам.Вставить(ПланОбменаМета.Имя, ДанныеПлана);
				КонецЕсли;
				
				ДанныеПлана.КодыУзлов.Добавить(КодыУзлов.Получить(УзелСсылки.Ключ));
				
			КонецЦикла;
		КонецЕсли;
		
		// Исходные ссылки без регистрации также остаются в отчете.
		Если УзлыПоПланам.Количество() = 0 Тогда
			УзлыПоПланам.Вставить("", Новый Структура("ПланОбмена, КодыУзлов", "", Новый Массив));
		КонецЕсли;
		
		Для Каждого ПланСсылки Из УзлыПоПланам Цикл
			
			НомерСтроки = НомерСтроки + 1;
			ОбластьСсылки = ТабличныйДокумент.Область(НомерСтроки, 1);
			ОбластьСсылки.Текст = Строка(Ссылка);
			ОбластьСсылки.Расшифровка = Ссылка;
			
			ТабличныйДокумент.Область(НомерСтроки, 2).Текст = ПланСсылки.Значение.ПланОбмена;
			ТабличныйДокумент.Область(НомерСтроки, 3).Текст = СтрСоединить(ПланСсылки.Значение.КодыУзлов, ", ");
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#КонецОбласти
