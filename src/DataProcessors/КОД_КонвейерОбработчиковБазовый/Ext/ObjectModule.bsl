#Область ОписаниеПеременных

Перем ПервыйОбработчик;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет обработчик в конец цепочки обработки.
//
// Параметры:
//  Обработчик - ОбработкаОбъект - добавляемый обработчик.
Процедура Добавить(Обработчик) Экспорт
	
	Если ПервыйОбработчик = Неопределено Тогда
		ПервыйОбработчик = Обработчик;
		Возврат;
	КонецЕсли;
	
	ПоследнийОбработчик = ПервыйОбработчик;
	Пока ПоследнийОбработчик.Следующий() <> Неопределено Цикл
		ПоследнийОбработчик = ПоследнийОбработчик.Следующий();
	КонецЦикла;
	
	ПоследнийОбработчик.Следующий(Обработчик);
	
КонецПроцедуры

// Запускает выполнение цепочки обработчиков.
//
// Параметры:
//  Контекст - ФиксированнаяСтруктура - контекст выполнения конвейера.
//  ВызыватьИсключение - Булево - признак повторного вызова исключения обработчика.
Процедура ВыполнитьОбработку(Контекст, ВызыватьИсключение = Ложь) Экспорт
	
	Если ПервыйОбработчик = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПервыйОбработчик.Обработать(Контекст);
	Исключение
		Если ВызыватьИсключение Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

// Создает контекст одного выполнения конвейера.
//
// Параметры:
//  Сценарий - ФиксированнаяСтруктура - описание выполняемого сценария.
//  МассивСсылок - Массив - исходные ссылки объектов.
//  ОбъектМетаданных - ОбъектМетаданных - метаданные исходных объектов.
//  ПланОбменаМета - ОбъектМетаданных - метаданные плана обмена.
//  МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - общий менеджер временных таблиц.
//  РежимВыполнения - Строка - режим выполнения конвейера.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - контекст выполнения конвейера.
Функция НовыйКонтекстВыполнения(Сценарий, МассивСсылок, ОбъектМетаданных, ПланОбменаМета,
		МенеджерВременныхТаблиц, РежимВыполнения = "Выполнение") Экспорт
	
	Вход = Новый Структура;
	Вход.Вставить("МассивСсылок", МассивСсылок);
	Вход.Вставить("ОбъектМетаданных", ОбъектМетаданных);
	Вход = Новый ФиксированнаяСтруктура(Вход);
	
	Выполнение = Новый Структура;
	Выполнение.Вставить("Идентификатор", Новый УникальныйИдентификатор);
	Выполнение.Вставить("ПланОбменаМета", ПланОбменаМета);
	Выполнение.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
	Выполнение.Вставить("Сценарий", Сценарий);
	Выполнение.Вставить("Режим", РежимВыполнения);
	Выполнение = Новый ФиксированнаяСтруктура(Выполнение);
	
	ТаблицаОбъектСообщение = Новый ТаблицаЗначений;
	ТаблицаОбъектСообщение.Колонки.Добавить("Ссылка");
	ТаблицаОбъектСообщение.Колонки.Добавить("Сообщение");
	ТаблицаОбъектСообщение.Колонки.Добавить("Заголовки");
	ТаблицаОбъектСообщение.Колонки.Добавить("Получатели");
	ТаблицаОбъектСообщение.Индексы.Добавить("Ссылка");
	
	Данные = Новый Структура;
	Данные.Вставить("ТаблицаОбъектСообщение", ТаблицаОбъектСообщение);
	Данные.Вставить("ВыходыОтладки", Новый Массив);

	Маршрутизация = Новый Структура;
	Маршрутизация.Вставить("Узел");
	
	Контекст = Новый Структура;
	Контекст.Вставить("Вход", Вход);
	Контекст.Вставить("Маршрутизация", Маршрутизация);
	Контекст.Вставить("Выполнение", Выполнение);
	Контекст.Вставить("Данные", Данные);
	
	Возврат Новый ФиксированнаяСтруктура(Контекст);
	
КонецФункции

// Возвращает результат маршрутизации конвейера.
Функция ПолучитьРезультатРегистрации(Контекст) Экспорт
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Контекст.Выполнение.МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ_СсылкиПоУзлам.Ссылка КАК Ссылка,
		|	ВТ_СсылкиПоУзлам.Узел КАК Узел
		|ИЗ
		|	ВТ_СсылкиПоУзлам КАК ВТ_СсылкиПоУзлам";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

